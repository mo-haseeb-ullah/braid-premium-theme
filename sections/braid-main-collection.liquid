<section class="braid-main-collection" style="background-color: var(--color-base-background-1);">
  <div class="collection-page-container">
    
    <header class="collection-header">
      <h1 class="collection-title">
        {% if section.settings.title_override != blank %}
          {{ section.settings.title_override | escape }}
        {% else %}
          {{ collection.title | escape }}
        {% endif %}
      </h1>
    </header>

    <form class="collection-toolbar" id="CollectionFiltersForm" method="GET">
      <div class="toolbar-left">
        {%- for filter in collection.filters -%}
          <details class="filter-dropdown">
            <summary class="filter-label">
              {{ filter.label }}
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.2"/></svg>
            </summary>
            <div class="filter-dropdown-content">
              {%- case filter.type -%}
                {%- when 'boolean' or 'list' -%}
                  <ul class="filter-list">
                    {%- for filter_value in filter.values -%}
                      <li>
                        <label class="filter-checkbox-label">
                          <input type="checkbox"
                            name="{{ filter_value.param_name }}"
                            value="{{ filter_value.value }}"
                            {% if filter_value.active %}checked{% endif %}
                          >
                          <span class="checkbox-custom"></span>
                          <span>{{ filter_value.label }}</span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- when 'price_range' -%}
                  <div class="filter-price-range">
                    <div class="price-inputs">
                      <div class="price-field">
                        <span class="currency-symbol">{{ cart.currency.symbol }}</span>
                        <input name="{{ filter.min_value.param_name }}"
                          type="number"
                          placeholder="0"
                          min="0"
                          max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                        >
                      </div>
                      <span class="price-separator">to</span>
                      <div class="price-field">
                        <span class="currency-symbol">{{ cart.currency.symbol }}</span>
                        <input name="{{ filter.max_value.param_name }}"
                          type="number"
                          placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          min="0"
                          max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                          {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                        >
                      </div>
                    </div>
                    <div class="price-max-text">The highest price is {{ filter.range_max | money }}</div>
                  </div>
              {%- endcase -%}
            </div>
          </details>
        {%- else -%}
          <!-- Fallbacks if Search & Discovery filters are not configured yet -->
          <details class="filter-dropdown">
            <summary class="filter-label">Availability <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.2"/></svg></summary>
            <div class="filter-dropdown-content">
               <ul class="filter-list">
                 <li><label class="filter-checkbox-label"><input type="checkbox"><span class="checkbox-custom"></span><span>In stock</span></label></li>
                 <li><label class="filter-checkbox-label"><input type="checkbox" disabled><span class="checkbox-custom"></span><span style="opacity:0.5;">Out of stock</span></label></li>
               </ul>
            </div>
          </details>
          <details class="filter-dropdown">
            <summary class="filter-label">Price <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.2"/></svg></summary>
            <div class="filter-dropdown-content">
               <div class="filter-price-range">
                  <div class="price-inputs">
                    <div class="price-field"><span class="currency-symbol">$</span><input type="number" placeholder="0"></div>
                    <span class="price-separator">to</span>
                    <div class="price-field"><span class="currency-symbol">$</span><input type="number" placeholder="220.00"></div>
                  </div>
                  <div class="price-max-text">The highest price is $220.00</div>
               </div>
            </div>
          </details>
        {%- endfor -%}
      </div>
      
      <div class="toolbar-right">
        <span class="product-count">{{ collection.products_count }} items</span>
        <details class="filter-dropdown sort-dropdown">
          <summary class="filter-label">
            Sort <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.2"/></svg>
          </summary>
          <div class="filter-dropdown-content">
            <ul class="filter-list">
              {%- for option in collection.sort_options -%}
                <li>
                  <label class="filter-radio-label">
                    <input type="radio" name="sort_by" value="{{ option.value }}" {% if option.value == collection.sort_by or option.value == collection.default_sort_by and collection.sort_by == blank %}checked{% endif %}>
                    <span class="radio-text">
                      {% if option.value == collection.sort_by or option.value == collection.default_sort_by and collection.sort_by == blank %}
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      {% endif %}
                      {{ option.name }}
                    </span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </details>
        <div class="grid-icons">
          <div class="grid-icon grid-icon-2col" data-col="2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="4" width="6" height="6"/><rect x="14" y="4" width="6" height="6"/><rect x="14" y="14" width="6" height="6"/><rect x="4" y="14" width="6" height="6"/></svg>
          </div>
          <div class="grid-icon grid-icon-4col active" data-col="4">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="4" height="4"/><rect x="10" y="3" width="4" height="4"/><rect x="17" y="3" width="4" height="4"/><rect x="3" y="10" width="4" height="4"/><rect x="10" y="10" width="4" height="4"/><rect x="17" y="10" width="4" height="4"/><rect x="3" y="17" width="4" height="4"/><rect x="10" y="17" width="4" height="4"/><rect x="17" y="17" width="4" height="4"/></svg>
          </div>
        </div>
      </div>
    </form>
    
    <script>
      // Form auto-submit
      document.getElementById('CollectionFiltersForm').addEventListener('change', function(e) {
        // Prevent submit if changing a text input (wait for blur)
        if(e.target.type !== 'number' && e.target.type !== 'text') {
           this.submit();
        } else {
           // For number inputs, wait for them to lose focus before submitting
           e.target.addEventListener('blur', () => { this.submit(); }, {once: true});
        }
      });

      // Close details when clicking outside
      document.addEventListener('click', function(event) {
        const details = document.querySelectorAll('.filter-dropdown');
        details.forEach(detail => {
          if (detail.hasAttribute('open') && !detail.contains(event.target)) {
            detail.removeAttribute('open');
          }
        });
      });

      // Grid View Toggle Logic
      document.querySelectorAll('.grid-icon').forEach(icon => {
        icon.addEventListener('click', function(e) {
          e.preventDefault();
          
          // Switch active state on buttons
          document.querySelectorAll('.grid-icon').forEach(i => i.classList.remove('active'));
          this.classList.add('active');
          
          // Switch grid columns
          const grid = document.querySelector('.collection-product-grid');
          if (this.getAttribute('data-col') === '2') {
            grid.classList.add('grid-layout-2');
          } else {
            grid.classList.remove('grid-layout-2');
          }
        });
      });
    </script>

    <div class="collection-product-grid">
      {% for product in collection.products %}
        <a href="{{ product.url }}" class="product-card">
          <div class="product-image-wrapper">
            {% if product.featured_image != blank %}
              <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title | escape }}" class="product-img primary-img">
              {% if product.images[1] != blank %}
                <img src="{{ product.images[1] | img_url: '600x' }}" alt="{{ product.title | escape }}" class="product-img secondary-img">
              {% endif %}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'product-placeholder' }}
            {% endif %}
          </div>
          <div class="product-info">
            <h3 class="product-title">{{ product.title }}</h3>
            <span class="product-price">{{ product.price | money }}</span>
          </div>
        </a>
      {% else %}
        <!-- Dummy products for the preview -->
        {% for i in (1..4) %}
          <div class="product-card">
            <div class="product-image-wrapper">
              {{ 'product-' | append: i | placeholder_svg_tag: 'product-placeholder' }}
            </div>
            <div class="product-info">
              <h3 class="product-title">Premium Braids {{ i }}</h3>
              <span class="product-price">.00</span>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
  .braid-main-collection {
    padding: 8rem 4rem 6rem;
    min-height: 80vh;
    background-color: var(--color-base-background-1);
  }
  .collection-page-container {
    max-width: 1400px;
    margin: 0 auto;
  }
  .collection-header {
    margin-bottom: 4rem;
  }
  .collection-title {
    font-size: 4.5rem;
    font-family: var(--font-heading-family) !important;
    color: var(--color-base-text);
    font-weight: 400;
    margin: 0;
    background: transparent !important;
  }
  .collection-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(140, 107, 93, 0.15); /* Soft brown border */
    padding-bottom: 1rem;
    margin-bottom: 3rem;
    font-size: 0.95rem;
    font-family: var(--font-body-family);
    color: var(--color-base-text);
  }
  .toolbar-left, .toolbar-right {
    display: flex;
    gap: 2rem;
    align-items: center;
  }
  .filter-label {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 0.8;
    position: relative;
  }
  .filter-dropdown {
    position: relative;
  }
  .filter-dropdown summary {
    list-style: none;
  }
  .filter-dropdown summary::-webkit-details-marker {
    display: none;
  }
  .filter-dropdown-content {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    background: #F8F3EC;
    border-radius: 12px;
    padding: 1rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    z-index: 10;
    min-width: 220px;
    border: 1px solid rgba(140, 107, 93, 0.1);
  }
  .sort-dropdown .filter-dropdown-content {
    left: auto;
    right: 0;
  }
  .filter-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .filter-checkbox-label, .filter-radio-label {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    color: var(--color-base-text);
  }
  .filter-checkbox-label input, .filter-radio-label input {
    display: none;
  }
  .checkbox-custom {
    width: 18px;
    height: 18px;
    border: 1px solid rgba(140, 107, 93, 0.3);
    border-radius: 4px;
    display: inline-block;
    position: relative;
    background: transparent;
  }
  .filter-checkbox-label input:checked + .checkbox-custom::after {
    content: '';
    position: absolute;
    top: 2px; left: 6px;
    width: 4px; height: 10px;
    border: solid var(--color-base-text);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .radio-text {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  /* Price Range Styles */
  .filter-price-range {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .price-inputs {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .price-field {
    display: flex;
    align-items: center;
    background: #fff;
    border-radius: 6px;
    padding: 0.5rem;
    border: 1px solid rgba(140, 107, 93, 0.2);
  }
  .price-field input {
    border: none;
    outline: none;
    width: 60px;
    background: transparent;
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--color-base-text);
  }
  .price-separator {
    font-size: 0.9rem;
    opacity: 0.6;
  }
  .price-max-text {
    font-size: 0.85rem;
    opacity: 0.6;
  }
  
  .product-count {
    opacity: 0.6;
  }
  .grid-icons {
    display: flex;
    gap: 4px;
    color: var(--color-base-text);
    opacity: 0.6;
    cursor: pointer;
  }
  .grid-icon {
    padding: 4px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .grid-icon.active {
    background-color: rgba(140, 107, 93, 0.1);
    opacity: 1;
  }
  
  .collection-product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    transition: all 0.3s ease;
  }
  .collection-product-grid.grid-layout-2 {
    grid-template-columns: repeat(2, 1fr);
  }
  .collection-product-grid.grid-layout-2 .product-image-wrapper {
    aspect-ratio: 4/5;
  }
  .product-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .product-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    background-color: #E6E2DA;
    margin-bottom: 1.2rem;
    overflow: hidden;
  }
  .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .secondary-img {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }
  .product-card:hover .primary-img {
    opacity: 0;
  }
  .product-card:hover .secondary-img {
    opacity: 1;
  }
  .product-card:hover .product-img {
    transform: scale(1.03);
  }
  .product-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-info {
    text-align: left;
  }
  .product-title {
    font-family: var(--font-heading-family) !important;
    font-size: 1.5rem;
    margin: 0 0 0.4rem 0;
    font-weight: 400;
    color: var(--color-base-text);
  }
  .product-price {
    font-size: 1rem;
    opacity: 0.8;
    font-family: var(--font-body-family);
    color: var(--color-base-text);
  }

  @media screen and (max-width: 1024px) {
    .collection-product-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (max-width: 768px) {
    .braid-main-collection { padding: 8rem 2rem 4rem; }
    .collection-title { font-size: 3rem; }
    .toolbar-right { display: none; }
  }
</style>

{% schema %}
{
  "name": "Braid Collection Grid",
  "settings": [
    {
      "type": "text",
      "id": "title_override",
      "label": "Heading Override",
      "info": "Leave blank to automatically use the collection's name (e.g. 'Products'). Type 'Services' here to override it."
    }
  ],
  "presets": [
    {
      "name": "Braid Collection Grid"
    }
  ]
}
{% endschema %}
