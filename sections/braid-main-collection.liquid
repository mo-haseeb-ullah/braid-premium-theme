<section class="braid-main-collection" style="background-color: var(--color-base-background-1);">
  <div class="collection-page-container">
    
    <header class="collection-header">
      <h1 class="collection-title">{{ collection.title | escape }}</h1>
    </header>

    <div class="collection-toolbar">
      <div class="toolbar-left">
        <span class="filter-label">Availability <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 5L5 1L9 5" stroke="currentColor" stroke-width="1.2"/></svg></span>
        <span class="filter-label">Price <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.2"/></svg></span>
      </div>
      <div class="toolbar-right">
        <span class="product-count">{{ collection.products_count }} items</span>
        <span class="filter-label">Sort <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.2"/></svg></span>
        <div class="grid-icons">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="4" width="6" height="6"/><rect x="14" y="4" width="6" height="6"/><rect x="14" y="14" width="6" height="6"/><rect x="4" y="14" width="6" height="6"/></svg>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="4" height="4"/><rect x="10" y="3" width="4" height="4"/><rect x="17" y="3" width="4" height="4"/><rect x="3" y="10" width="4" height="4"/><rect x="10" y="10" width="4" height="4"/><rect x="17" y="10" width="4" height="4"/><rect x="3" y="17" width="4" height="4"/><rect x="10" y="17" width="4" height="4"/><rect x="17" y="17" width="4" height="4"/></svg>
        </div>
      </div>
    </div>

    <div class="collection-product-grid">
      {% for product in collection.products %}
        <a href="{{ product.url }}" class="product-card">
          <div class="product-image-wrapper">
            {% if product.featured_image != blank %}
              <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title | escape }}" class="product-img primary-img">
              {% if product.images[1] != blank %}
                <img src="{{ product.images[1] | img_url: '600x' }}" alt="{{ product.title | escape }}" class="product-img secondary-img">
              {% endif %}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'product-placeholder' }}
            {% endif %}
          </div>
          <div class="product-info">
            <h3 class="product-title">{{ product.title }}</h3>
            <span class="product-price">{{ product.price | money }}</span>
          </div>
        </a>
      {% else %}
        <!-- Dummy products for the preview -->
        {% for i in (1..4) %}
          <div class="product-card">
            <div class="product-image-wrapper">
              {{ 'product-' | append: i | placeholder_svg_tag: 'product-placeholder' }}
            </div>
            <div class="product-info">
              <h3 class="product-title">Premium Braids {{ i }}</h3>
              <span class="product-price">.00</span>
            </div>
          </div>
        {% endfor %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
  .braid-main-collection {
    padding: 8rem 4rem 6rem;
    min-height: 80vh;
    background-color: var(--color-base-background-1);
  }
  .collection-page-container {
    max-width: 1400px;
    margin: 0 auto;
  }
  .collection-header {
    margin-bottom: 4rem;
  }
  .collection-title {
    font-size: 4.5rem;
    font-family: var(--font-heading-family) !important;
    color: var(--color-base-text);
    font-weight: 400;
    margin: 0;
    background: transparent !important;
  }
  .collection-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(140, 107, 93, 0.15); /* Soft brown border */
    padding-bottom: 1rem;
    margin-bottom: 3rem;
    font-size: 0.95rem;
    font-family: var(--font-body-family);
    color: var(--color-base-text);
  }
  .toolbar-left, .toolbar-right {
    display: flex;
    gap: 2rem;
    align-items: center;
  }
  .filter-label {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 0.8;
  }
  .product-count {
    opacity: 0.6;
  }
  .grid-icons {
    display: flex;
    gap: 10px;
    color: var(--color-base-text);
    opacity: 0.6;
    cursor: pointer;
  }
  
  .collection-product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .product-card {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .product-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    background-color: #E6E2DA;
    margin-bottom: 1.2rem;
    overflow: hidden;
  }
  .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .secondary-img {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }
  .product-card:hover .primary-img {
    opacity: 0;
  }
  .product-card:hover .secondary-img {
    opacity: 1;
  }
  .product-card:hover .product-img {
    transform: scale(1.03);
  }
  .product-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-info {
    text-align: left;
  }
  .product-title {
    font-family: var(--font-heading-family) !important;
    font-size: 1.5rem;
    margin: 0 0 0.4rem 0;
    font-weight: 400;
    color: var(--color-base-text);
  }
  .product-price {
    font-size: 1rem;
    opacity: 0.8;
    font-family: var(--font-body-family);
    color: var(--color-base-text);
  }

  @media screen and (max-width: 1024px) {
    .collection-product-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (max-width: 768px) {
    .braid-main-collection { padding: 8rem 2rem 4rem; }
    .collection-title { font-size: 3rem; }
    .toolbar-right { display: none; }
  }
</style>

{% schema %}
{
  "name": "Braid Collection Grid",
  "settings": [],
  "presets": [
    {
      "name": "Braid Collection Grid"
    }
  ]
}
{% endschema %}
