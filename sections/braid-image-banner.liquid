<section class="braid-luxury-banner">
  <div class="luxury-banner-wrapper">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | img_url: '2000x' }}" class="luxury-banner-bg" alt="Luxury Banner">
    {% else %}
      <img src="{{ 'braid-image-160.png' | asset_url }}" class="luxury-banner-bg" alt="Luxury Banner">
    {% endif %}
    <div class="luxury-banner-overlay"></div>
    <div class="luxury-banner-content">
      <h2 class="luxury-banner-title">{{ section.settings.title | default: 'Luxury Hair for Women Who Lead' }}</h2>
      <a href="{{ section.settings.button_link }}" class="btn luxury-banner-btn">{{ section.settings.button_text | default: 'Shop Now' }}</a>
    </div>
  </div>
</section>

<style>
  .braid-luxury-banner {
    width: 100%;
  }
  .luxury-banner-wrapper {
    position: relative;
    width: 100%;
    height: 450px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .luxury-banner-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .luxury-banner-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.35);
    z-index: 2;
  }
  .luxury-banner-content {
    position: relative;
    z-index: 3;
    text-align: center;
  }
  .luxury-banner-title {
    font-family: var(--font-heading-family) !important;
    font-size: 3.5rem;
    font-weight: 400;
    font-style: italic;
    color: #ffffff !important;
    margin-bottom: 2rem;
    letter-spacing: 1px;
  }
  .luxury-banner-btn {
    display: inline-block;
    padding: 1rem 3rem;
    background-color: transparent !important;
    color: #fff !important;
    text-decoration: none;
    font-family: var(--font-body-family);
    font-weight: 400;
    font-size: 0.95rem;
    border: 1px solid #fff;
    border-radius: 8px;
    transition: all 0.3s ease;
    letter-spacing: 1px;
  }
  .luxury-banner-btn:hover {
    background-color: #fff !important;
    color: var(--color-base-text) !important;
  }

  @media screen and (max-width: 768px) {
    .luxury-banner-title { font-size: 2.2rem; }
    .luxury-banner-wrapper { height: 350px; }
  }
</style>

{% schema %}
{
  "name": "Braid Luxury Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Luxury Hair for Women Who Lead"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Braid Luxury Banner"
    }
  ]
}
{% endschema %}
