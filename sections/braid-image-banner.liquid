<section class="braid-image-banner">
  <div class="banner-background">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | img_url: '2000x' }}" class="banner-bg-img">
    {% else %}
      <div class="banner-placeholder"></div>
    {% endif %}
    <div class="banner-overlay" style="background-color: rgba(0,0,0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});"></div>
  </div>
  
  <div class="banner-content-box">
    {% if section.settings.subheading != blank %}
      <p class="banner-subheading">{{ section.settings.subheading }}</p>
    {% endif %}
    
    <h2 class="banner-heading">{{ section.settings.heading }}</h2>
    
    {% if section.settings.text != blank %}
      <div class="banner-text">{{ section.settings.text }}</div>
    {% endif %}
    
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="btn banner-btn">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

<style>
  .braid-image-banner {
    position: relative;
    width: 100%;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #ffffff;
    padding: 4rem 2rem;
  }
  .banner-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .banner-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .banner-placeholder {
    width: 100%;
    height: 100%;
    background-color: #5A3D2B;
  }
  .banner-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }
  .banner-content-box {
    position: relative;
    z-index: 3;
    max-width: 800px;
  }
  .banner-subheading {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  .banner-heading {
    font-size: 4rem;
    font-family: var(--font-heading-family);
    margin-bottom: 2rem;
    color: #ffffff;
  }
  .banner-text {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 2rem;
  }
  @media screen and (max-width: 768px) {
    .banner-heading { font-size: 2.5rem; }
  }
</style>

{% schema %}
{
  "name": "Braid Image Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "label": "Overlay Opacity",
      "default": 30
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Luxury Hair for Women Who Lead"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Braid Image Banner"
    }
  ]
}
{% endschema %}
