<footer class="braid-footer-section">
  <div class="footer-top">
    <div class="footer-container">
      <!-- Left: Newsletter -->
      <div class="footer-newsletter-col">
        <h3 class="footer-newsletter-title">{{ section.settings.newsletter_title | default: 'Join the Club' }}</h3>
        <form class="footer-newsletter-form">
          <div class="newsletter-input-wrapper">
            <input type="email" placeholder="Email Address" class="newsletter-input">
            <button type="submit" class="newsletter-submit">&rarr;</button>
          </div>
        </form>
      </div>
      
      <!-- Right: Link Columns -->
      <div class="footer-links-wrapper">
        <div class="footer-links-col">
          <h4 class="footer-links-heading">{{ section.settings.col1_title | default: 'OUR COMPANY' }}</h4>
          <ul class="footer-links-list">
            <li><a href="#">About Us</a></li>
            <li><a href="#">Services</a></li>
            <li><a href="#">Gallery</a></li>
            <li><a href="#">Blog</a></li>
          </ul>
        </div>
        <div class="footer-links-col">
          <h4 class="footer-links-heading">{{ section.settings.col2_title | default: 'HELP & SUPPORT' }}</h4>
          <ul class="footer-links-list">
            <li><a href="#">FAQs</a></li>
            <li><a href="#">Contact</a></li>
            <li><a href="#">Booking Policy</a></li>
            <li><a href="#">Shipping & Returns</a></li>
          </ul>
        </div>
        <div class="footer-links-col">
          <h4 class="footer-links-heading">{{ section.settings.col3_title | default: 'CONNECT' }}</h4>
          <ul class="footer-links-list">
            <li><a href="#">Instagram</a></li>
            <li><a href="#">TikTok</a></li>
            <li><a href="#">Pinterest</a></li>
            <li><a href="#">YouTube</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Massive Logo -->
  <div class="footer-logo-section">
    <h2 class="footer-mega-logo">braid<em>theory</em></h2>
  </div>
  
  <div class="footer-bottom">
    <p class="footer-copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved. | <a href="#">Privacy Policy</a></p>
  </div>
</footer>

<style>
  .braid-footer-section {
    background-color: #FAEDDE;
    border-top: 1px solid rgba(74,52,36,0.1);
  }
  .footer-top {
    padding: 5rem 4rem 4rem 4rem;
  }
  .footer-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 6rem;
  }
  
  /* Newsletter */
  .footer-newsletter-title {
    font-family: var(--font-heading-family) !important;
    font-size: 2rem;
    font-weight: 400;
    color: var(--color-base-text) !important;
    margin-bottom: 1.5rem;
  }
  .newsletter-input-wrapper {
    display: flex;
    border-bottom: 1.5px solid var(--color-base-text);
    padding-bottom: 0.5rem;
    max-width: 320px;
  }
  .newsletter-input {
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-body-family);
    font-size: 1rem;
    color: var(--color-base-text);
    flex: 1;
    padding: 0.5rem 0;
  }
  .newsletter-input::placeholder {
    color: #8c6b5d;
  }
  .newsletter-submit {
    background: transparent !important;
    border: none !important;
    color: var(--color-base-text) !important;
    font-size: 1.3rem;
    cursor: pointer;
    padding: 0 !important;
    margin: 0 !important;
    box-shadow: none !important;
  }

  /* Link Columns */
  .footer-links-wrapper {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
  }
  .footer-links-heading {
    font-family: var(--font-body-family) !important;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-base-text) !important;
    margin-bottom: 1.5rem;
  }
  .footer-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-links-list li {
    margin-bottom: 0.8rem;
  }
  .footer-links-list a {
    text-decoration: none;
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    color: var(--color-base-text);
    transition: opacity 0.3s;
  }
  .footer-links-list a:hover {
    opacity: 0.6;
  }

  /* Mega Logo */
  .footer-logo-section {
    padding: 2rem 4rem 1rem 4rem;
    text-align: center;
    overflow: hidden;
  }
  .footer-mega-logo {
    font-family: var(--font-heading-family) !important;
    font-size: 12rem;
    font-weight: 400;
    color: var(--color-base-text) !important;
    margin: 0;
    line-height: 1;
    letter-spacing: 2px;
    white-space: nowrap;
  }
  .footer-mega-logo em {
    font-style: italic;
    font-weight: 300;
  }

  /* Bottom bar */
  .footer-bottom {
    padding: 1.5rem 4rem;
    border-top: 1px solid rgba(74,52,36,0.1);
  }
  .footer-copyright {
    font-family: var(--font-body-family);
    font-size: 0.8rem;
    color: #8c6b5d;
    text-align: center;
  }
  .footer-copyright a {
    color: #8c6b5d;
    text-decoration: none;
  }

  @media screen and (max-width: 900px) {
    .footer-container { grid-template-columns: 1fr; gap: 3rem; }
    .footer-links-wrapper { grid-template-columns: repeat(2, 1fr); }
    .footer-mega-logo { font-size: 5rem; }
  }
  @media screen and (max-width: 500px) {
    .footer-links-wrapper { grid-template-columns: 1fr; }
    .footer-mega-logo { font-size: 3.5rem; }
  }
</style>

{% schema %}
{
  "name": "Braid Footer",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Title",
      "default": "Join the Club"
    },
    {
      "type": "text",
      "id": "col1_title",
      "label": "Column 1 Heading",
      "default": "OUR COMPANY"
    },
    {
      "type": "text",
      "id": "col2_title",
      "label": "Column 2 Heading",
      "default": "HELP & SUPPORT"
    },
    {
      "type": "text",
      "id": "col3_title",
      "label": "Column 3 Heading",
      "default": "CONNECT"
    }
  ]
}
{% endschema %}
