<section class="braid-services-section">
  <div class="services-container">
    
    <!-- Top Row: Title and Text -->
    <div class="services-header">
      <div class="services-title-col">
        <h2 class="services-title">{{ section.settings.title | default: 'Our Services' }}</h2>
      </div>
      <div class="services-text-col">
        <p class="services-text">{{ section.settings.text | default: 'Whether you?re going for a protective look, a bold transformation, or a signature everyday style ? our expert braiders have you covered. Choose your look, reserve your time, and let us handle the rest.' }}</p>
      </div>
    </div>

    <!-- Middle Row: 4 Column Grid -->
    <div class="services-grid">
      {% for block in section.blocks %}
        <div class="service-card" {{ block.shopify_attributes }}>
          <div class="service-image-wrapper">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '600x' }}" class="service-img" alt="{{ block.settings.title }}">
            {% else %}
              <!-- Auto Fallback Demo Images based on loop index -->
              {% assign demo_image = 'braid-image-' | append: forloop.index | append: '.jpg' %}
              <img src="{{ demo_image | asset_url }}" class="service-img fallback-demo" alt="Demo Image">
            {% endif %}
          </div>
          <h3 class="service-card-title">{{ block.settings.title | default: 'Service Name' }}</h3>
          <p class="service-card-price">{{ block.settings.price | default: '.00' }}</p>
        </div>
      {% endfor %}

      <!-- If no blocks are added by user in editor, show 4 default demo cards! -->
      {% if section.blocks.size == 0 %}
        <div class="service-card">
          <div class="service-image-wrapper"><img src="{{ 'braid-image-20.png' | asset_url }}" class="service-img"></div>
          <h3 class="service-card-title">Knotless Braids</h3>
          <p class="service-card-price">.00</p>
        </div>
        <div class="service-card">
          <div class="service-image-wrapper"><img src="{{ 'braid-image-21.png' | asset_url }}" class="service-img"></div>
          <h3 class="service-card-title">Goddess Braids</h3>
          <p class="service-card-price">.00</p>
        </div>
        <div class="service-card">
          <div class="service-image-wrapper"><img src="{{ 'braid-image-23.png' | asset_url }}" class="service-img"></div>
          <h3 class="service-card-title">Cornrows with Design</h3>
          <p class="service-card-price">.00</p>
        </div>
        <div class="service-card">
          <div class="service-image-wrapper"><img src="{{ 'braid-image-24.png' | asset_url }}" class="service-img"></div>
          <h3 class="service-card-title">Boho Braids</h3>
          <p class="service-card-price">.00</p>
        </div>
      {% endif %}
    </div>

    <!-- Bottom Row: Button -->
    <div class="services-footer">
      <a href="{{ section.settings.button_link }}" class="btn services-btn">{{ section.settings.button_text | default: 'View Full Service Menu' }}</a>
    </div>

  </div>
</section>

<style>
  .braid-services-section {
    padding: 10rem 4rem 6rem 4rem;
    background-color: var(--color-base-background-1);
  }
  .services-container {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  /* Header Layout */
  .services-header {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    margin-bottom: 4rem;
    gap: 5rem;
  }
  .services-title-col {
    flex: 0 0 auto;
  }
  .services-title {
    font-family: var(--font-heading-family);
    font-size: 2.8rem;
    font-weight: 400;
    color: var(--color-base-text);
    margin: 0;
  }
  .services-text-col {
    flex: 0 0 auto;
  }
  .services-text {
    font-family: var(--font-body-family);
    font-size: 1.15rem; font-weight: 400;
    line-height: 1.6;
    color: var(--color-base-text);
    margin: 0;
    max-width: 530px;
  }

  /* Grid Layout */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-bottom: 4rem;
  }
  .service-card {
    display: flex;
    flex-direction: column;
  }
  .service-image-wrapper {
    width: 100%;
    aspect-ratio: 3/4; /* Matches the tall portrait aspect ratio */
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  .service-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .service-card:hover .service-img {
    transform: scale(1.03); /* Subtle hover effect */
  }
  .service-card-title {
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--color-base-text);
    margin: 0 0 0.5rem 0;
  }
  .service-card-price {
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    color: #666;
    margin: 0;
  }

  /* Footer Button */
  .services-footer {
    text-align: center;
  }
  .services-btn {
    display: inline-block;
    padding: 1.2rem 3rem;
    background-color: var(--color-base-accent-1) !important;
    color: #fff !important;
    text-decoration: none;
    font-family: var(--font-body-family);
    font-weight: 500;
    font-size: 1rem;
    border-radius: 8px;
    text-transform: none;
    letter-spacing: normal;
    transition: background-color 0.3s ease;
  }
  .services-btn:hover {
    background-color: var(--color-base-text) !important;
  }

  @media screen and (max-width: 1024px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (max-width: 768px) {
    .services-header { flex-direction: column; gap: 1.5rem; }
    .services-grid { grid-template-columns: 1fr; }
    .braid-services-section { padding: 4rem 2rem; }
  }
</style>

{% schema %}
{
  "name": "Braid Services Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our Services"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description Text"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View Full Service Menu"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service Card",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Service Title",
          "default": "Service Name"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": ".00"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Braid Services Grid"
    }
  ]
}
{% endschema %}






