<section class="braid-services-section">
  <div class="services-container">
    
    <!-- Top Row: Title and Text -->
    <div class="services-header">
      <div class="services-title-col">
        <h2 class="services-title">{{ section.settings.title | default: 'Our Services' }}</h2>
      </div>
      <div class="services-text-col">
        <p class="services-text">{{ section.settings.text | default: 'Whether you?re going for a protective look, a bold transformation, or a signature everyday style ? our expert braiders have you covered. Choose your look, reserve your time, and let us handle the rest.' }}</p>
      </div>
    </div>

    <!-- Middle Row: 4 Column Grid -->
    <div class="services-grid">
      {% for block in section.blocks %}
        {% assign prod = block.settings.product %}
        {% assign card_link = block.settings.link %}
        {% if card_link == blank and prod != blank %}{% assign card_link = prod.url %}{% endif %}

        {% if card_link != blank %}
        <a href="{{ card_link }}" class="service-card-link" {{ block.shopify_attributes }}>
        {% else %}
        <div class="service-card-link" {{ block.shopify_attributes }}>
        {% endif %}
          <div class="service-card">
            <div class="service-image-wrapper">
              {% assign card_image = block.settings.image %}
              {% if card_image == blank and prod != blank %}{% assign card_image = prod.featured_image %}{% endif %}
              
              {% assign card_hover = block.settings.hover_image %}
              {% if card_hover == blank and prod != blank %}{% assign card_hover = prod.images[1] %}{% endif %}

              {% if card_image != blank %}
                <img src="{{ card_image | img_url: '600x' }}" class="service-img primary-img" alt="">
                {% if card_hover != blank %}
                  <img src="{{ card_hover | img_url: '600x' }}" class="service-img secondary-img" alt="">
                {% endif %}
              {% else %}
                <div class="service-img-placeholder">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" style="width:48px;height:48px;opacity:0.3;">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                  <span>Select Product</span>
                </div>
              {% endif %}
            </div>
            
            {% assign card_title = block.settings.title %}
            {% if prod != blank and card_title == 'Service Name' or card_title == blank %}
              {% assign card_title = prod.title %}
            {% endif %}
            <h3 class="service-card-title">{{ card_title }}</h3>
            
            {% if prod != blank %}
              <p class="service-card-price">{{ prod.price | money }}</p>
            {% else %}
              <p class="service-card-price">{{ block.settings.price | default: '.00' }}</p>
            {% endif %}
          </div>
        {% if card_link != blank %}
        </a>
        {% else %}
        </div>
        {% endif %}
      {% endfor %}


    </div>

    <!-- Bottom Row: Button -->
    <div class="services-footer">
      <a href="{{ section.settings.button_link }}" class="btn services-btn">{{ section.settings.button_text | default: 'View Full Service Menu' }}</a>
    </div>

  </div>
</section>

<style>
  .braid-services-section {
    padding: 4rem 4rem 6rem 4rem;
    background-color: var(--color-base-background-1);
  }
  .services-container {
    max-width: 1400px;
    margin: 0 auto;
  }
  
  /* Header Layout */
  .services-header {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    margin-bottom: 4rem;
    gap: 5rem;
  }
  .services-title-col {
    flex: 0 0 auto;
  }
  .services-title {
    font-family: var(--font-heading-family);
    font-size: 2.8rem;
    font-weight: 400;
    color: var(--color-base-text);
    margin: 0;
  }
  .services-text-col {
    flex: 0 0 auto;
  }
  .services-text {
    font-family: var(--font-body-family);
    font-size: 1.15rem; font-weight: 400;
    line-height: 1.6;
    color: var(--color-base-text);
    margin: 0;
    max-width: 530px;
  }

  /* Grid Layout */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-bottom: 4rem;
  }
  .service-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .service-card {
    display: flex;
    flex-direction: column;
  }
  .service-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4; /* Matches the tall portrait aspect ratio */
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  .service-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .secondary-img {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
  }
  .service-card:hover .primary-img {
    opacity: 0;
  }
  .service-card:hover .secondary-img {
    opacity: 1;
  }
  .service-card:hover .service-img {
    transform: scale(1.03);
  }
  .service-img-placeholder {
    width: 100%;
    height: 100%;
    background-color: rgba(74,52,36,0.08);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    color: #8c6b5d;
  }
  .service-img-placeholder span {
    font-family: var(--font-body-family);
    font-size: 0.85rem;
    opacity: 0.4;
  }
  .service-card-title {
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--color-base-text);
    margin: 0 0 0.5rem 0;
  }
  .service-card-price {
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    color: #666;
    margin: 0;
  }

  /* Footer Button */
  .services-footer {
    text-align: center;
  }
  .services-btn {
    display: inline-block;
    padding: 1.2rem 3rem;
    background-color: var(--color-base-accent-1) !important;
    color: #fff !important;
    text-decoration: none;
    font-family: var(--font-body-family);
    font-weight: 500;
    font-size: 1rem;
    border-radius: 8px;
    text-transform: none;
    letter-spacing: normal;
    transition: background-color 0.3s ease;
  }
  .services-btn:hover {
    background-color: var(--color-base-text) !important;
  }

  @media screen and (max-width: 1024px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media screen and (max-width: 768px) {
    .services-header { flex-direction: column; gap: 1.5rem; }
    .services-grid { grid-template-columns: 1fr; }
    .braid-services-section { padding: 4rem 2rem; }
  }
</style>

{% schema %}
{
  "name": "Braid Services Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Our Services"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description Text"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View Full Service Menu"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service Card",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product (Auto-fills everything below)"
        },
        {
          "type": "header",
          "content": "Manual Overrides",
          "info": "Fill these in ONLY if you want to override the product's default info, or if you aren't linking a product."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image Override"
        },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Hover Image Override"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Service Title",
          "default": "Service Name"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": ".00"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link Override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Braid Services Grid",
      "blocks": [
        {
          "type": "service",
          "settings": {
            "title": "Knotless Braids",
            "price": "From $150.00"
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Goddess Braids",
            "price": "From $175.00"
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Cornrows with Design",
            "price": "From $120.00"
          }
        },
        {
          "type": "service",
          "settings": {
            "title": "Boho Braids",
            "price": "From $200.00"
          }
        }
      ]
    }
  ]
}
{% endschema %}






