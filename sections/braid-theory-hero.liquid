<section class="braid-hero">
  <div class="braid-hero-image-container">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | img_url: 'master' }}" alt="Hero" class="braid-hero-img">
    {% else %}
      <div class="braid-hero-placeholder"></div>
    {% endif %}
    
    <div class="braid-hero-overlay">
      <h1 class="braid-hero-title">{{ section.settings.heading }}</h1>
    </div>
  </div>
</section>

<style>
  .braid-hero {
    width: 100%;
    height: 80vh;
    position: relative;
  }
  .braid-hero-image-container {
    width: 100%;
    height: 100%;
    position: relative;
  }
  .braid-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .braid-hero-placeholder {
    width: 100%;
    height: 100%;
    background-color: #d8c8bd;
  }
  .braid-hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.2);
  }
  .braid-hero-title {
    color: #ffffff;
    font-size: 8rem;
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
    margin: 0;
    text-shadow: 2px 2px 10px rgba(0,0,0,0.1);
  }
  @media screen and (max-width: 768px) {
    .braid-hero-title {
      font-size: 4rem;
    }
  }
</style>

{% schema %}
{
  "name": "Braid Theory Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "braidtheory"
    }
  ],
  "presets": [
    {
      "name": "Braid Theory Hero",
      "category": "Image"
    }
  ]
}
{% endschema %}
