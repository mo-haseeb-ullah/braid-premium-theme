<section class="braid-hero-section">
  {% if section.settings.image != blank %}
    <img src="{{ section.settings.image | img_url: '2000x' }}" class="hero-bg" alt="Hero">
  {% else %}
    <!-- Auto-fallback demo image so it looks beautiful instantly -->
    <img src="{{ 'braid-image-1.png' | asset_url }}" class="hero-bg" alt="Hero Placeholder">
  {% endif %}
  
  <div class="hero-overlay"></div>
  
  <div class="hero-content">
    <h1 class="hero-title">
      {{ section.settings.title | default: 'braid<em>theory</em>' }}
    </h1>
  </div>
</section>

<style>
  /* Force the header to be transparent and sit on top of the hero! */
  #shopify-section-header {
    position: absolute;
    top: 0;
    width: 100%;
    z-index: 100;
    background: transparent !important;
  }
  .header-wrapper {
    background: transparent !important;
    border-bottom: none !important;
  }
  .header__menu-item, .header__icon {
    color: #4a3424 !important; /* Brown text for nav */
  }

  .braid-hero-section {
    position: relative;
    width: 100%;
    height: 90vh; /* Takes up most of the screen */
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-top: -200px; /* Pull it up under the header */
  }
  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(246, 243, 235, 0.4) 0%, rgba(0,0,0,0) 20%, rgba(246, 243, 235, 0.8) 100%);
    z-index: 2;
  }
  .hero-content { margin-top: 6rem;
    position: relative;
    z-index: 3;
    text-align: center;
    width: 100%;
  }
  .hero-title {
    font-size: 8rem;
    color: #ffffff !important;
    margin: 0;
    font-weight: 400;
    letter-spacing: -1px;
    text-shadow: 0px 4px 15px rgba(0,0,0,0.2);
  }
  .hero-title em {
    font-style: italic;
    font-weight: 300;
  }

  @media screen and (max-width: 768px) {
    .hero-title { font-size: 4rem; }
    .braid-hero-section { height: 70vh; margin-top: -150px; }
  }
</style>

{% schema %}
{
  "name": "Braid Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "info": "Use <em> tags for italics",
      "default": "braid<em>theory</em>"
    }
  ],
  "presets": [
    {
      "name": "Braid Hero"
    }
  ]
}
{% endschema %}




