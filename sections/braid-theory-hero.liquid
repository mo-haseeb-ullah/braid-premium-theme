<section class="braid-hero-section">
  {% if section.settings.image != blank %}
    <img src="{{ section.settings.image | img_url: '2000x' }}" class="hero-bg" alt="Hero">
  {% else %}
    <img src="{{ 'braid-image-1.png' | asset_url }}" class="hero-bg" alt="Hero">
  {% endif %}
  
  <div class="hero-overlay"></div>
  
  <div class="hero-content">
    <h1 class="hero-title">The Braid <em>Studio</em></h1>
  </div>
</section>

<style>
  /* HOMEPAGE ONLY: Override header to white text over hero image */
  .braid-header .header-link {
    color: #ffffff !important;
  }
  .braid-header .logo-text {
    color: #ffffff !important;
  }
  .braid-header .header-icon {
    color: #ffffff !important;
  }

  /* HOMEPAGE ONLY: White background on hover */
  .braid-header:hover {
    background-color: #ffffff !important;
  }
  .braid-header:hover .header-link,
  .braid-header:hover .header-icon,
  .braid-header:hover .logo-text {
    color: #4a3424 !important;
  }

  .braid-hero-section {
    position: relative;
    width: 100%;
    height: 85vh;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    margin-top: -120px;
    padding-top: 120px;
  }
  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0) 30%, rgba(0,0,0,0.3) 100%);
    z-index: 2;
  }
  .hero-content {
    position: relative;
    z-index: 3;
    text-align: center;
    width: 100%;
    padding-bottom: 6rem;
  }
  .hero-title {
    font-family: var(--font-heading-family) !important;
    font-size: 10rem !important;
    color: #ffffff !important;
    margin: 0;
    font-weight: 400;
    letter-spacing: 3px;
    text-shadow: 0px 4px 20px rgba(0,0,0,0.15);
  }
  .hero-title em {
    font-style: italic;
    font-weight: 300;
  }

  @media screen and (max-width: 768px) {
    .hero-title { font-size: 4.5rem !important; }
    .braid-hero-section { height: 75vh; }
    .hero-content { padding-bottom: 3rem; }
  }
</style>

{% schema %}
{
  "name": "Braid Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    }
  ],
  "presets": [
    {
      "name": "Braid Hero"
    }
  ]
}
{% endschema %}
