<section class="braid-icon-row">
  <div class="icon-row-container">
    {% for block in section.blocks %}
      <div class="icon-item">
        <div class="icon-svg">
          {% if block.settings.icon != blank %}
            <img src="{{ block.settings.icon | img_url: '100x' }}" alt="">
          {% else %}
            <!-- Default placeholder icon -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          {% endif %}
        </div>
        <div class="icon-text">
          <h4 class="icon-title">{{ block.settings.title }}</h4>
          <p class="icon-desc">{{ block.settings.text }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<style>
  .braid-icon-row {
    padding: 4rem 2rem;
    background-color: var(--color-base-background-1);
    border-top: 1px solid rgba(0,0,0,0.05);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  .icon-row-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }
  .icon-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex: 1;
  }
  .icon-svg {
    width: 50px;
    height: 50px;
    color: var(--color-base-text);
  }
  .icon-svg svg {
    width: 100%;
    height: 100%;
  }
  .icon-title {
    font-size: 1.2rem;
    font-family: var(--font-heading-family);
    margin-bottom: 0.2rem;
  }
  .icon-desc {
    font-size: 0.9rem;
    opacity: 0.7;
    margin: 0;
  }
  @media screen and (max-width: 768px) {
    .icon-row-container {
      flex-direction: column;
      gap: 3rem;
    }
  }
</style>

{% schema %}
{
  "name": "Braid Icon Row",
  "settings": [],
  "blocks": [
    {
      "type": "icon",
      "name": "Icon Block",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Fast Delivery"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "We deliver your order safely and reliably."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Braid Icon Row",
      "blocks": [
        { "type": "icon" },
        { "type": "icon", "settings": { "title": "Diamond Quality" } },
        { "type": "icon", "settings": { "title": "Customer-First Care" } }
      ]
    }
  ]
}
{% endschema %}
