<header class="braid-header">
  <div class="header-container">
    
    <!-- Left Navigation -->
    <nav class="header-nav-left">
      <a href="/" class="header-link">Home</a>
      <a href="/collections/all" class="header-link">Shop</a>
      <a href="/collections/services" class="header-link">Services</a>
      <a href="/pages/about" class="header-link">About</a>
      <a href="/pages/faqs" class="header-link">FAQs</a>
      
      {% if section.settings.blog != blank %}
        <a href="{{ section.settings.blog.url }}" class="header-link">Blog</a>
      {% else %}
        <a href="/blogs/news" class="header-link">Blog</a>
      {% endif %}
      
      {% if section.settings.contact_page != blank %}
        <a href="{{ section.settings.contact_page.url }}" class="header-link">Contact</a>
      {% else %}
        <a href="/pages/contact" class="header-link">Contact</a>
      {% endif %}
    </nav>
    
    <!-- Center Logo -->
    <div class="header-logo" {% if template.name == 'index' and section.settings.hide_on_home %}style="visibility: hidden;"{% endif %}>
      <a href="/">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | img_url: '400x' }}" alt="{{ shop.name }}">
        {% else %}
          <span class="logo-text">{{ section.settings.logo_text }}</span>
        {% endif %}
      </a>
    </div>
    
    <!-- Right Icons -->
    <div class="header-icons-right">
      <a href="/search" class="header-icon"><svg viewBox="0 0 20 20" style="width:20px;height:20px;"><path fill-rule="evenodd" d="M8.5 2a6.5 6.5 0 100 13 6.5 6.5 0 000-13zM0 8.5a8.5 8.5 0 1115.358 5.444l4.5 4.5a1 1 0 01-1.414 1.414l-4.5-4.5A8.5 8.5 0 010 8.5z" fill="currentColor"></path></svg></a>
      
      <div class="header-account-wrapper">
        <a href="/account" class="header-icon" onclick="toggleAccountMenu(event)"><svg viewBox="0 0 20 20" style="width:22px;height:22px;"><path d="M10 9a4 4 0 100-8 4 4 0 000 8zm0-2a2 2 0 110-4 2 2 0 010 4zM4.093 16C4.542 13.791 6.522 12 10 12s5.458 1.791 5.907 4H4.093zM2.03 16.488C2.868 12.83 6.07 10 10 10s7.132 2.83 7.97 6.488A1 1 0 0117.001 18H2.999a1 1 0 01-.97-1.512z" fill="currentColor"></path></svg></a>
        
        <div id="account-dropdown-menu" class="account-dropdown-box">
          <h3 class="account-dropdown-title">{{ section.settings.account_title | default: 'Account' }}</h3>
          
          <a href="/account/login" class="btn-shop-login">
            Sign in with <span style="font-weight: 800; letter-spacing: -0.5px;">shop</span>
          </a>
          
          <a href="/account/login" class="btn-other-login">{{ section.settings.other_login_text | default: 'Other sign in options' }}</a>
          
          <div class="account-grid">
            <a href="/account?view=orders" class="account-grid-item">
              <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"></path></svg>
              Orders
            </a>
            <a href="/account" class="account-grid-item">
              <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              Profile
            </a>
          </div>
        </div>
      </div>
      
      <a href="/cart" class="header-icon cart-icon-wrapper" onclick="openCartDrawer(event)">
        <svg viewBox="0 0 20 20" style="width:22px;height:22px;"><path fill-rule="evenodd" d="M14 6V4a4 4 0 10-8 0v2H2v10a2 2 0 002 2h12a2 2 0 002-2V6h-4zm-2 0H8V4a2 2 0 114 0v2zm4 2H4v8h12V8z" fill="currentColor"></path></svg>
        <span id="cart-count-bubble" class="cart-bubble" {% if cart.item_count == 0 %}style="display:none;"{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
    
  </div>
</header>

<style>
  #shopify-section-header, .shopify-section-header, [id*="header-group"] {
    position: absolute !important;
    top: 0;
    left: 0;
    width: 100% !important;
    z-index: 9999 !important;
    background: transparent !important;
  }

  .braid-header {
    width: 100%;
    padding: 2.5rem 4rem;
    background: transparent !important;
    transition: background-color 0.3s ease;
  }
  
  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .header-nav-left {
    flex: 1;
    display: flex;
    gap: 1.8rem;
  }

  .header-link {
    text-decoration: none;
    color: #4a3424 !important;
    font-family: var(--font-body-family);
    font-size: 1.25rem;
    font-weight: 300;
    letter-spacing: 0.5px;
    text-transform: capitalize;
    transition: color 0.3s ease, opacity 0.3s ease;
  }
  .header-link:hover {
    opacity: 0.6;
  }

  .header-logo {
    flex: 1;
    text-align: center;
  }
  .header-logo a {
    text-decoration: none;
    display: inline-block;
  }
  .header-logo img {
    max-height: 45px;
    width: auto;
    object-fit: contain;
  }
  .logo-text {
    font-family: var(--font-heading-family);
    font-size: 2.8rem;
    font-weight: 400;
    color: #4a3424;
    transition: color 0.3s ease;
  }
  .logo-text em {
    font-style: italic;
    font-weight: 300;
  }

  .header-icons-right {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    gap: 2rem;
    align-items: center;
  }

  .header-icon {
    color: #4a3424 !important;
    transition: color 0.3s ease, opacity 0.3s ease;
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .header-icon:hover {
    opacity: 0.6;
  }
  
  .cart-icon-wrapper {
    position: relative;
  }
  .cart-bubble {
    position: absolute;
    top: -8px;
    right: -10px;
    background-color: #6C4F3D;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    font-family: var(--font-body-family);
    min-width: 18px;
    height: 18px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    line-height: 1;
  }

  /* Account Dropdown */
  .header-account-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  .account-dropdown-box {
    position: absolute;
    top: 150%;
    right: -20px;
    width: 320px;
    background-color: var(--color-base-background-1, #FAEDDE);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.3s ease;
    z-index: 1000;
  }
  .account-dropdown-box.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .account-dropdown-title {
    font-family: var(--font-heading-family);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--color-base-text);
    margin-top: 0;
    margin-bottom: 1.2rem;
  }
  .btn-shop-login {
    display: block;
    width: 100%;
    background-color: #5A31F4;
    color: white;
    text-align: center;
    padding: 0.8rem;
    border-radius: 8px;
    text-decoration: none;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 0.8rem;
    transition: background-color 0.2s;
  }
  .btn-shop-login:hover { background-color: #4823d4; }
  .btn-other-login {
    display: block;
    width: 100%;
    background-color: #6C4F3D;
    color: white;
    text-align: center;
    padding: 0.8rem;
    border-radius: 8px;
    text-decoration: none;
    font-family: var(--font-body-family);
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 1rem;
    transition: background-color 0.2s;
  }
  .btn-other-login:hover { background-color: #553E30; }
  
  .account-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }
  .account-grid-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: rgba(108, 79, 61, 0.1);
    color: var(--color-base-text);
    padding: 0.8rem;
    border-radius: 8px;
    text-decoration: none;
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    font-weight: 500;
    transition: background-color 0.2s;
  }
  .account-grid-item:hover {
    background-color: rgba(108, 79, 61, 0.15);
  }

  @media screen and (max-width: 768px) {
    .header-nav-left { display: none; }
    .braid-header { padding: 1.5rem 2rem; }
  }
</style>

<script>
  function toggleAccountMenu(e) {
    if(e) e.preventDefault();
    document.getElementById('account-dropdown-menu').classList.toggle('active');
  }
  
  document.addEventListener('click', function(event) {
    const wrapper = document.querySelector('.header-account-wrapper');
    const menu = document.getElementById('account-dropdown-menu');
    if (wrapper && !wrapper.contains(event.target)) {
      menu.classList.remove('active');
    }
  });
</script>

{% schema %}
{
  "name": "Braid Header",
  "settings": [
    {
      "type": "checkbox",
      "id": "hide_on_home",
      "label": "Hide logo on homepage",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "The Braid <em>Studio</em>",
      "info": "Use <em>text</em> to make part of it italic."
    },
    {
      "type": "text",
      "id": "account_title",
      "label": "Account Dropdown Title",
      "default": "Account"
    },
    {
      "type": "text",
      "id": "other_login_text",
      "label": "Other Sign In Text",
      "default": "Other sign in options"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Select Blog for Navigation"
    },
    {
      "type": "page",
      "id": "contact_page",
      "label": "Select Contact Page for Navigation"
    }
  ]
}
{% endschema %}
