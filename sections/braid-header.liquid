<header class="braid-header">
  <div class="header-container">
    <!-- Left Navigation -->
    <nav class="header-nav-left">
      {% for link in linklists.main-menu.links %}
        <a href="{{ link.url }}" class="header-link">{{ link.title }}</a>
      {% endfor %}
    </nav>
    
    <!-- Center Logo -->
    <div class="header-logo">
      <a href="/">
        {% if section.settings.logo != blank %}
          <img src="{{ section.settings.logo | img_url: '400x' }}" alt="{{ shop.name }}">
        {% else %}
          <span class="logo-text" style="font-family: var(--font-heading-family); font-size: 2.2rem; font-weight: 400; color: #4a3424;">braid<em style="font-style:italic;font-weight:300;">theory</em></span>
        {% endif %}
      </a>
    </div>
    
    <!-- Right Icons -->
    <div class="header-icons">
      <a href="/search" class="icon-link">{% render 'icon-search' %}Search</a>
      <a href="/account" class="icon-link">{% render 'icon-account' %}Account</a>
      <a href="/cart" class="icon-link">{% render 'icon-cart' %}Cart</a>
    </div>
  </div>
</header>

<style>
  .braid-header {
    width: 100%;
    padding: 1.5rem 4rem;
    position: absolute; /* Overlaps hero on homepage */
    top: 0;
    left: 0;
    z-index: 100;
    background-color: transparent;
  }
  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1600px;
    margin: 0 auto;
  }
  .header-nav-left {
    flex: 1;
    display: flex;
    gap: 2rem;
  }
  .header-link {
    text-decoration: none;
    color: var(--color-base-text);
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }
  .header-logo {
    flex: 1;
    text-align: center;
  }
  .logo-text {
    font-family: var(--font-heading-family);
    font-size: 2.5rem;
    font-style: italic;
    color: var(--color-base-text);
    text-decoration: none;
  }
  .header-logo a { text-decoration: none; }
  .header-icons {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    gap: 1.5rem;
  }
  .icon-link {
    text-decoration: none;
    color: var(--color-base-text);
    font-size: 0.8rem;
    text-transform: uppercase;
  }
</style>

{% schema %}
{
  "name": "Braid Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    }
  ]
}
{% endschema %}

