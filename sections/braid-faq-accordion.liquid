<section class="braid-faq-section" style="background-color: var(--color-base-background-1);">
  <div class="faq-container">
    
    <!-- Left Image -->
    <div class="faq-image-col">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: '1000x' }}" alt="FAQ Image" class="faq-img">
      {% else %}
        <div class="placeholder-img" style="background-color: #E6E2DA; width: 100%; height: 100%; min-height: 600px; border-radius: 20px;"></div>
      {% endif %}
    </div>

    <!-- Right Content (Accordion) -->
    <div class="faq-content-col">
      <h2 class="faq-heading">{{ section.settings.heading | default: "FAQs – Frequently Asked Questions" }}</h2>
      
      <div class="faq-accordion-wrapper">
        {% for block in section.blocks %}
          <details class="faq-item" {{ block.shopify_attributes }}>
            <summary class="faq-question">
              {{ block.settings.title }}
              <svg class="faq-icon" width="12" height="8" viewBox="0 0 12 8" fill="none"><path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1.5"/></svg>
            </summary>
            <div class="faq-answer">
              {{ block.settings.text }}
            </div>
          </details>
        {% endfor %}
      </div>
    </div>
    
  </div>
</section>

<style>
  .braid-faq-section {
    padding: 6rem 4rem;
  }
  .faq-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: start;
  }
  .faq-image-col {
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    position: sticky;
    top: 120px;
  }
  .faq-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    border-radius: 20px;
  }
  
  .faq-content-col {
    padding-top: 2rem;
  }
  .faq-heading {
    font-family: var(--font-heading-family) !important;
    font-size: 2.5rem;
    font-weight: 400;
    color: var(--color-base-text);
    margin: 0 0 3rem 0;
  }

  .faq-accordion-wrapper {
    display: flex;
    flex-direction: column;
  }
  
  .faq-item {
    border-bottom: 1px solid rgba(140, 107, 93, 0.2);
  }
  .faq-item:first-child {
    border-top: 1px solid rgba(140, 107, 93, 0.2);
  }
  
  .faq-question {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
    font-family: var(--font-heading-family);
    font-size: 1.5rem;
    color: var(--color-base-text);
    font-weight: 400;
    transition: opacity 0.3s ease;
  }
  .faq-question::-webkit-details-marker {
    display: none;
  }
  .faq-question:hover {
    opacity: 0.7;
  }
  
  .faq-icon {
    transition: transform 0.3s ease;
    opacity: 0.6;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }
  
  .faq-answer {
    padding: 0 0 1.5rem 0;
    font-family: var(--font-body-family);
    font-size: 1.05rem;
    color: var(--color-base-text);
    opacity: 0.85;
    line-height: 1.6;
  }

  @media screen and (max-width: 1024px) {
    .faq-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .faq-image-col {
      position: relative;
      top: 0;
    }
    .faq-heading {
      font-size: 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQs – Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "Return policy"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Answer",
          "default": "<p>Our goal is for every customer to be totally satisfied with their purchase. If this isn't the case, let us know and we'll do our best to work with you to make it right.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item", "settings": { "title": "Shipping", "text": "<p>We will work quickly to ship your order as soon as possible. Once your order has shipped, you will receive an email with further information.</p>" } },
        { "type": "faq_item", "settings": { "title": "Manufacturing", "text": "<p>Our products are manufactured both locally and globally. We carefully select our manufacturing partners to ensure our products are high quality and a fair value.</p>" } }
      ]
    }
  ]
}
{% endschema %}
