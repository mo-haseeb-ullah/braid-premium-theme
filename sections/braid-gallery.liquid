<section class="braid-gallery">
  <div class="gallery-container">
    {% for block in section.blocks %}
      <div class="gallery-item">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | img_url: '800x' }}" class="gallery-img">
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'gallery-placeholder' }}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

<style>
  .braid-gallery {
    width: 100%;
    overflow: hidden;
  }
  .gallery-container {
    display: flex;
    width: 100%;
  }
  .gallery-item {
    flex: 1;
    aspect-ratio: 4/5;
  }
  .gallery-img, .gallery-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery-placeholder {
    background-color: #e8e8e1;
    border-right: 1px solid white;
  }
</style>

{% schema %}
{
  "name": "Braid Gallery Band",
  "settings": [],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery Image",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Braid Gallery Band",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
