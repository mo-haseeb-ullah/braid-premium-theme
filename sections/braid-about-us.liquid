<section class="braid-about" style="background-color: var(--color-base-background-1);">
  <div class="about-container">
    <div class="about-image-side">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: '1000x' }}" alt="About" class="about-img">
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'about-placeholder' }}
      {% endif %}
    </div>
    
    <div class="about-text-side">
      <h2 class="about-title">About <em>{{ section.settings.heading }}</em></h2>
      <p class="about-text">{{ section.settings.text }}</p>
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="btn">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .braid-about {
    padding: 6rem 4rem;
  }
  .about-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 4rem;
  }
  .about-image-side {
    width: 50%;
  }
  .about-img {
    width: 100%;
    border-radius: 12px;
    object-fit: cover;
  }
  .about-placeholder {
    width: 100%;
    background-color: #d8c8bd;
    border-radius: 12px;
  }
  .about-text-side {
    width: 50%;
  }
  .about-title {
    font-size: 2.5rem;
    margin-bottom: 1.5rem;
    color: var(--color-base-text);
  }
  .about-title em {
    font-family: var(--font-heading-family);
    font-style: italic;
  }
  .about-text {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 2rem;
  }
  @media screen and (max-width: 768px) {
    .about-container {
      flex-direction: column;
    }
    .about-image-side, .about-text-side {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Braid About Us",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "About Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Braid Theory"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We believe in the power of beautiful hair..."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Braid About Us"
    }
  ]
}
{% endschema %}
