<section class="braid-about-section">
  <div class="about-container">
    <div class="about-image-col">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: '1000x' }}" class="about-img" alt="About Us">
      {% else %}
        <!-- Demo fallback image -->
        <img src="{{ 'braid-image-100.png' | asset_url }}" class="about-img fallback-demo" alt="About Braid Theory">
      {% endif %}
    </div>
    
    <div class="about-text-col">
      <h2 class="about-title">{{ section.settings.title | default: 'About Braid<em>Theory</em>' }}</h2>
      <div class="about-text">
        {{ section.settings.text | default: '<p>Braiding isn’t just a hairstyle — it’s a legacy.</p><p>At Braid<em>Theory</em>, we celebrate the art, care, and culture behind every braid. From luxury braided wigs to custom in-studio styles, we’re here to help you express your beauty, protect your crown, and wear your roots with pride.</p>' }}
      </div>
      <a href="{{ section.settings.button_link }}" class="btn about-btn">{{ section.settings.button_text | default: 'More About Us' }}</a>
    </div>
  </div>
</section>

<style>
  .braid-about-section {
    padding: 8rem 4rem;
    background-color: var(--color-base-background-1);
  }
  .about-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 6rem;
  }
  
  .about-image-col {
    flex: 1;
  }
  .about-img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    object-fit: cover;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }
  
  .about-text-col {
    flex: 1;
    max-width: 500px;
  }
  .about-title {
    font-family: var(--font-heading-family);
    font-size: 2.8rem;
    font-weight: 400;
    color: var(--color-base-text);
    margin-bottom: 2rem;
  }
  .about-title em, .about-text em {
    font-style: italic;
    font-weight: 300;
  }
  .about-text {
    font-family: var(--font-body-family);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-base-text);
    margin-bottom: 2.5rem;
  }
  .about-text p {
    margin-bottom: 1rem;
  }
  
  .about-btn {
    display: inline-block;
    padding: 1.2rem 3rem;
    background-color: var(--color-base-accent-1) !important;
    color: #fff !important;
    text-decoration: none;
    font-family: var(--font-body-family);
    font-weight: 500;
    font-size: 1rem;
    border-radius: 8px;
    text-transform: none;
    letter-spacing: normal;
    transition: background-color 0.3s ease;
  }
  .about-btn:hover {
    background-color: var(--color-base-text) !important;
  }

  @media screen and (max-width: 900px) {
    .about-container { flex-direction: column; gap: 3rem; }
    .about-text-col { max-width: 100%; text-align: center; }
  }
</style>

{% schema %}
{
  "name": "Braid About Split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "About Braid<em>Theory</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description Text"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "More About Us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Braid About Split"
    }
  ]
}
{% endschema %}
