<section class="braid-about-section">
  <div class="about-container">
    <div class="about-image-col">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: '1200x' }}" class="about-img" alt="About Us">
      {% else %}
        <img src="{{ 'braid-image-100.png' | asset_url }}" class="about-img fallback-demo" alt="About The Braid Studio">
      {% endif %}
    </div>
    
    <div class="about-text-col">
      <h2 class="about-title">{{ section.settings.title | default: 'About Braid<em>Theory</em>' }}</h2>
      <div class="about-text">
        <p>Braiding isn&#39;t just a hairstyle &mdash; it&#39;s a legacy.</p>
        <p>At Braid<em>Theory</em>, we celebrate the art, care, and culture behind every braid. From luxury braided wigs to custom in-studio styles, we&#39;re here to help you express your beauty, protect your crown, and wear your roots with pride.</p>
      </div>
      <a href="{{ section.settings.button_link }}" class="btn about-btn">{{ section.settings.button_text | default: 'More About Us' }}</a>
    </div>
  </div>
</section>

<style>
  .braid-about-section {
    padding: 8rem 4rem;
    background-color: var(--color-base-background-1);
  }
  .about-container {
    max-width: 1600px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 8rem;
  }
  
  .about-image-col {
    width: 100%;
  }
  .about-img {
    width: 100%;
    aspect-ratio: 4/5;
    border-radius: 20px;
    object-fit: cover;
    display: block;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  }
  
  .about-text-col {
    max-width: 550px;
  }
  .about-title {
    font-family: var(--font-heading-family);
    font-size: 3rem;
    font-weight: 400;
    color: var(--color-base-text);
    margin-bottom: 1.5rem;
  }
  .about-title em, .about-text em {
    font-style: italic;
    font-weight: 300;
  }
  .about-text {
    font-family: var(--font-body-family);
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-base-text);
    margin-bottom: 2.5rem;
  }
  .about-text p {
    margin-bottom: 1rem;
  }
  
  .about-btn {
    display: inline-block;
    padding: 1.2rem 3.5rem;
    background-color: var(--color-base-accent-1) !important;
    color: #fff !important;
    text-decoration: none;
    font-family: var(--font-body-family);
    font-weight: 500;
    font-size: 1.05rem;
    border-radius: 12px;
    text-transform: none;
    letter-spacing: normal;
    transition: background-color 0.3s ease;
  }
  .about-btn:hover {
    background-color: var(--color-base-text) !important;
  }

  @media screen and (max-width: 1024px) {
    .about-container { grid-template-columns: 1fr; gap: 4rem; }
    .about-text-col { max-width: 100%; text-align: center; margin: 0 auto; }
  }
  @media screen and (max-width: 768px) {
    .braid-about-section { padding: 4rem 2rem; }
  }
</style>

{% schema %}
{
  "name": "Braid About Split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "About Braid<em>Theory</em>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "More About Us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Braid About Split"
    }
  ]
}
{% endschema %}
