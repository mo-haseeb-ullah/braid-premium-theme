<section class="braid-about-hero" style="background-color: var(--color-base-background-1);">
  <div class="about-hero-container">
    <div class="about-hero-image-col">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: '1000x' }}" alt="About Hero" class="about-hero-img">
      {% else %}
        <div class="placeholder-img" style="background-color: #E6E2DA; width: 100%; height: 100%; min-height: 600px; border-radius: 20px;"></div>
      {% endif %}
    </div>
    
    <div class="about-hero-text-col">
      <h2 class="about-hero-heading">{{ section.settings.heading | default: "We don't just braid hair — we honor identity." }}</h2>
      <div class="about-hero-text">
        {{ section.settings.text | default: "<p>At BraidTheory, every braid begins with intention. Our mission is to celebrate and elevate the beauty of textured hair through premium-quality braiding products, timeless styles, and color collections made to match every shade of melanin.</p><p>We believe braiding is more than style — it’s culture, history, and self-expression. Whether you're going for knotless, boho, goddess, or cornrows, we're here to give you the tools, inspiration, and confidence to wear your crown, your way.</p>" }}
      </div>
    </div>
  </div>
</section>

<style>
  .braid-about-hero {
    padding: 6rem 4rem;
  }
  .about-hero-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }
  .about-hero-image-col {
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
  }
  .about-hero-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    border-radius: 20px;
  }
  .about-hero-heading {
    font-family: var(--font-heading-family) !important;
    font-size: 2.8rem;
    font-weight: 400;
    color: var(--color-base-text);
    margin: 0 0 2rem 0;
    line-height: 1.2;
  }
  .about-hero-text {
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    color: var(--color-base-text);
    line-height: 1.7;
    opacity: 0.85;
  }
  .about-hero-text p {
    margin-bottom: 1.5rem;
  }
  .about-hero-text p:last-child {
    margin-bottom: 0;
  }
  
  @media screen and (max-width: 1024px) {
    .about-hero-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .about-hero-heading {
      font-size: 2.2rem;
    }
  }
</style>

{% schema %}
{
  "name": "About Hero Split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We don't just braid hair — we honor identity."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body Text",
      "default": "<p>At BraidTheory, every braid begins with intention. Our mission is to celebrate and elevate the beauty of textured hair through premium-quality braiding products, timeless styles, and color collections made to match every shade of melanin.</p><p>We believe braiding is more than style — it’s culture, history, and self-expression. Whether you're going for knotless, boho, goddess, or cornrows, we're here to give you the tools, inspiration, and confidence to wear your crown, your way.</p>"
    }
  ],
  "presets": [
    {
      "name": "About Hero Split"
    }
  ]
}
{% endschema %}
