<section class="braid-about-hero-section">
  <div class="about-hero-container">
    <div class="about-hero-image-col">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: '1000x' }}" alt="About Us">
      {% else %}
        <img src="{{ 'braid-image-100.png' | asset_url }}" alt="About Us">
      {% endif %}
    </div>
    <div class="about-hero-text-col">
      <h2 class="about-hero-heading">{{ section.settings.heading | default: 'We don&#39;t just braid hair &mdash; we honor identity.' }}</h2>
      <div class="about-hero-text">
        <p>{{ section.settings.text_1 | default: 'At BraidTheory, we believe that braiding is more than a craft. It is an ancient art form, a cultural tradition, and a deeply personal expression of beauty. We are here to celebrate that legacy while pushing it forward.' }}</p>
        <p>{{ section.settings.text_2 | default: 'From our curated collection of premium braided wigs to our in-studio custom styles, every piece we create is made with intention, precision, and love. Our team blends traditional braiding techniques with modern aesthetics to deliver looks that are not only beautiful but meaningful.' }}</p>
        <p>{{ section.settings.text_3 | default: 'We are dedicated to inclusivity. Every style, every texture, and every pattern is designed to honor the diversity of Black hair and to empower you to wear your crown with pride.' }}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .braid-about-hero-section {
    padding: 0 4rem 6rem 4rem;
    background-color: #FAEDDE;
  }
  .about-hero-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }
  .about-hero-image-col img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    border-radius: 16px;
    display: block;
  }
  .about-hero-text-col {
    padding-top: 4rem;
  }
  .about-hero-heading {
    font-family: var(--font-heading-family) !important;
    font-size: 2.8rem;
    font-weight: 400;
    font-style: italic;
    color: var(--color-base-text) !important;
    margin-bottom: 2.5rem;
    line-height: 1.3;
  }
  .about-hero-text {
    font-family: var(--font-body-family);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-base-text);
  }
  .about-hero-text p {
    margin-bottom: 1.5rem;
  }

  @media screen and (max-width: 900px) {
    .about-hero-container { grid-template-columns: 1fr; gap: 2rem; }
    .about-hero-text-col { padding-top: 0; }
    .braid-about-hero-section { padding: 0 2rem 4rem 2rem; }
  }
</style>

{% schema %}
{
  "name": "About Hero Split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Paragraph 1"
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Paragraph 2"
    },
    {
      "type": "textarea",
      "id": "text_3",
      "label": "Paragraph 3"
    }
  ],
  "presets": [
    {
      "name": "About Hero Split"
    }
  ]
}
{% endschema %}
