<section class="braid-marquee-section">
  <div class="marquee-track">
    <div class="marquee-content">
      <span>{{ section.settings.text | default: 'About us' }}</span>
      <span>{{ section.settings.text | default: 'About us' }}</span>
      <span>{{ section.settings.text | default: 'About us' }}</span>
      <span>{{ section.settings.text | default: 'About us' }}</span>
      <span>{{ section.settings.text | default: 'About us' }}</span>
      <span>{{ section.settings.text | default: 'About us' }}</span>
      <span>{{ section.settings.text | default: 'About us' }}</span>
      <span>{{ section.settings.text | default: 'About us' }}</span>
    </div>
  </div>
</section>

<style>
  .braid-marquee-section {
    padding: 4rem 0 3rem 0;
    background-color: #FAEDDE;
    overflow: hidden;
  }
  .marquee-track {
    width: 100%;
    overflow: hidden;
  }
  .marquee-content {
    display: flex;
    gap: 2rem;
    white-space: nowrap;
    animation: marquee-scroll 20s linear infinite;
  }
  .marquee-content span {
    font-family: var(--font-heading-family);
    font-size: 5rem;
    font-weight: 400;
    font-style: italic;
    color: var(--color-base-text);
    flex-shrink: 0;
  }
  .marquee-content span:nth-child(even) {
    -webkit-text-stroke: 1px var(--color-base-text);
    -webkit-text-fill-color: transparent;
  }

  @keyframes marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media screen and (max-width: 768px) {
    .marquee-content span { font-size: 3rem; }
  }
</style>

{% schema %}
{
  "name": "Braid Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Scrolling Text",
      "default": "About us"
    }
  ],
  "presets": [
    {
      "name": "Braid Marquee"
    }
  ]
}
{% endschema %}
