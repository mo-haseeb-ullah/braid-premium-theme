<section class="braid-marquee-banner">
  <div class="marquee-background">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | img_url: '2000x' }}" class="marquee-img">
    {% else %}
      <div class="marquee-placeholder"></div>
    {% endif %}
    <div class="marquee-overlay" style="background-color: rgba(0,0,0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});"></div>
  </div>

  <div class="marquee-track-container">
    <div class="marquee-track">
      <h2 class="marquee-text">{{ section.settings.text }} &nbsp;&nbsp;&nbsp; {{ section.settings.text }} &nbsp;&nbsp;&nbsp; {{ section.settings.text }} &nbsp;&nbsp;&nbsp; {{ section.settings.text }}</h2>
      <!-- Duplicate for infinite scroll illusion -->
      <h2 class="marquee-text">{{ section.settings.text }} &nbsp;&nbsp;&nbsp; {{ section.settings.text }} &nbsp;&nbsp;&nbsp; {{ section.settings.text }} &nbsp;&nbsp;&nbsp; {{ section.settings.text }}</h2>
    </div>
  </div>
</section>

<style>
  .braid-marquee-banner {
    position: relative;
    width: 100%;
    height: 50vh;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .marquee-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  .marquee-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .marquee-placeholder {
    width: 100%;
    height: 100%;
    background-color: #5A3D2B;
  }
  .marquee-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }
  
  .marquee-track-container {
    position: relative;
    z-index: 3;
    width: 100%;
    overflow: hidden;
    white-space: nowrap;
  }
  .marquee-track {
    display: inline-block;
    animation: scrollMarquee {{ section.settings.speed }}s linear infinite;
  }
  .marquee-text {
    display: inline-block;
    font-size: 5rem;
    font-family: var(--font-heading-family);
    color: #ffffff;
    margin: 0;
    padding-right: 1rem;
    font-weight: 400;
  }
  
  @keyframes scrollMarquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media screen and (max-width: 768px) {
    .braid-marquee-banner { height: 35vh; }
    .marquee-text { font-size: 3rem; }
  }
</style>

{% schema %}
{
  "name": "Braid Marquee Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "label": "Image Darkening Overlay",
      "default": 20
    },
    {
      "type": "text",
      "id": "text",
      "label": "Scrolling Text",
      "default": "Luxury Hair for Women Who Lead"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "sec",
      "label": "Scroll Speed (Lower is faster)",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Braid Marquee Banner"
    }
  ]
}
{% endschema %}
