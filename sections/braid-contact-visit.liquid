<section class="braid-contact-visit" style="background-color: var(--color-base-background-1);">
  <div class="contact-visit-container">
    
    <!-- Left Image -->
    <div class="contact-visit-image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | img_url: '1000x' }}" alt="{{ section.settings.heading }}" class="visit-img">
      {% else %}
        <div class="placeholder-img" style="background-color: #E6E2DA; width: 100%; height: 100%; min-height: 500px; border-radius: 20px;"></div>
      {% endif %}
    </div>

    <!-- Right Content -->
    <div class="contact-visit-content">
      <h2 class="visit-heading">{{ section.settings.heading }}</h2>
      
      <div class="visit-details">
        {% for block in section.blocks %}
          <div class="visit-block" {{ block.shopify_attributes }}>
            {% if block.settings.title != blank %}
              <h4 class="visit-block-title">{{ block.settings.title }}</h4>
            {% endif %}
            <div class="visit-block-text">
              {{ block.settings.text }}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
    
  </div>
</section>

<style>
  .braid-contact-visit {
    padding: 6rem 4rem;
  }
  .contact-visit-container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }
  .contact-visit-image {
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
  }
  .visit-img {
    width: 100%;
    height: 100%;
    max-height: 700px;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 20px;
  }
  
  .contact-visit-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .visit-heading {
    font-family: var(--font-heading-family) !important;
    font-size: 3rem;
    font-weight: 400;
    color: var(--color-base-text);
    margin: 0 0 3rem 0;
  }

  .visit-details {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  
  .visit-block-title {
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    color: var(--color-base-text);
  }
  
  .visit-block-text {
    font-family: var(--font-body-family);
    font-size: 1.05rem;
    color: var(--color-base-text);
    line-height: 1.6;
    opacity: 0.85;
  }
  .visit-block-text p {
    margin: 0;
  }

  @media screen and (max-width: 900px) {
    .contact-visit-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .visit-heading {
      font-size: 2.5rem;
    }
    .braid-contact-visit {
      padding: 4rem 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "Contact Visit Us",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visit us"
    }
  ],
  "blocks": [
    {
      "type": "text_info",
      "name": "Info Block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title (e.g. Hours)",
          "info": "Leave blank if no bold title is needed."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>123 Demo Street<br>New York, NY 12345</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact Visit Us",
      "blocks": [
        { "type": "text_info", "settings": { "title": "", "text": "<p>123 Demo Street<br>New York, NY 12345</p>" } },
        { "type": "text_info", "settings": { "title": "Hours", "text": "<p>Monday-Friday<br>10am-6pm</p>" } },
        { "type": "text_info", "settings": { "title": "Phone", "text": "<p>(555) 555-555</p>" } }
      ]
    }
  ]
}
{% endschema %}
