<section class="braid-fullwidth-image">
  {% if section.settings.image != blank %}
    <img src="{{ section.settings.image | img_url: '2000x' }}" alt="Full Width" class="fullwidth-img">
  {% else %}
    <img src="{{ 'braid-image-136.png' | asset_url }}" alt="Full Width" class="fullwidth-img">
  {% endif %}
</section>

<style>
  .braid-fullwidth-image {
    width: 100%;
    overflow: hidden;
  }
  .fullwidth-img {
    width: 100%;
    height: 500px;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 768px) {
    .fullwidth-img { height: 300px; }
  }
</style>

{% schema %}
{
  "name": "Braid Full Width Image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Braid Full Width Image"
    }
  ]
}
{% endschema %}
