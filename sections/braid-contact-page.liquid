<section class="braid-contact-page" style="background-color: var(--color-base-background-1);">
  <div class="contact-container">
    
    <!-- Top Row: Image Left, Info Right -->
    <div class="contact-row">
      <div class="contact-image-side">
        {% if section.settings.image_top != blank %}
          <img src="{{ section.settings.image_top | img_url: '1000x' }}" class="contact-img">
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'contact-placeholder' }}
        {% endif %}
      </div>
      
      <div class="contact-info-side">
        <h2 class="contact-title">Visit us</h2>
        <div class="contact-details">
          <p><strong>{{ section.settings.address_title }}</strong><br>{{ section.settings.address_text | newline_to_br }}</p>
          <p><strong>{{ section.settings.hours_title }}</strong><br>{{ section.settings.hours_text | newline_to_br }}</p>
          <p><strong>{{ section.settings.phone_title }}</strong><br>{{ section.settings.phone_text }}</p>
        </div>
      </div>
    </div>

    <!-- Bottom Row: Form Left, Image Right -->
    <div class="contact-row reverse-mobile">
      <div class="contact-form-side">
        <h2 class="contact-title">Contact us</h2>
        
        {% form 'contact', class: 'contact-form' %}
          <div class="form-row">
            <input type="text" name="contact[name]" placeholder="Name" class="form-input" required>
            <input type="email" name="contact[email]" placeholder="Email" class="form-input" required>
          </div>
          <input type="tel" name="contact[phone]" placeholder="Phone" class="form-input full-width">
          <textarea name="contact[body]" placeholder="Comment" rows="6" class="form-input full-width"></textarea>
          <button type="submit" class="btn contact-btn">Submit</button>
        {% endform %}
        
      </div>
      
      <div class="contact-image-side">
        {% if section.settings.image_bottom != blank %}
          <img src="{{ section.settings.image_bottom | img_url: '1000x' }}" class="contact-img">
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'contact-placeholder' }}
        {% endif %}
      </div>
    </div>

  </div>
</section>

<style>
  .braid-contact-page {
    padding: 10rem 4rem 6rem;
  }
  .contact-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 8rem;
  }
  .contact-row {
    display: flex;
    align-items: center;
    gap: 6rem;
  }
  .contact-image-side {
    flex: 1;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 4/5;
  }
  .contact-img, .contact-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .contact-placeholder {
    background-color: #E6E2DA;
  }
  
  .contact-info-side {
    flex: 1;
    text-align: center;
  }
  .contact-title {
    font-size: 2.5rem;
    font-family: var(--font-heading-family);
    color: var(--color-base-text);
    margin-bottom: 2rem;
    font-weight: 400;
  }
  .contact-details p {
    margin-bottom: 1.5rem;
    line-height: 1.6;
    font-size: 1rem;
    color: #555;
  }
  .contact-details strong {
    color: var(--color-base-text);
    font-weight: 600;
  }

  .contact-form-side {
    flex: 1;
    text-align: center;
    padding: 0 2rem;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: left;
  }
  .form-row {
    display: flex;
    gap: 1rem;
  }
  .form-input {
    width: 100%;
    padding: 1rem;
    border: none;
    background-color: #ffffff;
    border-radius: 4px;
    font-family: var(--font-body-family);
  }
  .form-input.full-width {
    width: 100%;
  }
  .contact-btn {
    align-self: flex-start;
    margin-top: 1rem;
  }

  @media screen and (max-width: 900px) {
    .contact-row { flex-direction: column; gap: 3rem; }
    .contact-row.reverse-mobile { flex-direction: column-reverse; }
    .contact-image-side, .contact-info-side, .contact-form-side { width: 100%; }
    .braid-contact-page { padding: 8rem 2rem 4rem; }
  }
</style>

{% schema %}
{
  "name": "Braid Contact Page",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_top",
      "label": "Top Image"
    },
    {
      "type": "text",
      "id": "address_title",
      "label": "Address Title",
      "default": "123 Demo Street"
    },
    {
      "type": "textarea",
      "id": "address_text",
      "label": "Address Text",
      "default": "New York, NY 12345"
    },
    {
      "type": "text",
      "id": "hours_title",
      "label": "Hours Title",
      "default": "Hours"
    },
    {
      "type": "textarea",
      "id": "hours_text",
      "label": "Hours Text",
      "default": "Monday–Friday\n10am–6pm"
    },
    {
      "type": "text",
      "id": "phone_title",
      "label": "Phone Title",
      "default": "Phone"
    },
    {
      "type": "text",
      "id": "phone_text",
      "label": "Phone Number",
      "default": "(555) 555-555"
    },
    {
      "type": "image_picker",
      "id": "image_bottom",
      "label": "Bottom Image"
    }
  ],
  "presets": [
    {
      "name": "Braid Contact Page"
    }
  ]
}
{% endschema %}
