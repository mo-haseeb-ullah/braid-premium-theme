<section class="braid-main-blog" style="background-color: var(--color-base-background-1);">
  <div class="blog-container">
    
    <header class="blog-header">
      <h1 class="blog-title">
        {% if section.settings.title_override != blank %}
          {{ section.settings.title_override | escape }}
        {% else %}
          {{ blog.title | escape }}
        {% endif %}
      </h1>
    </header>

    <div class="blog-articles">
      {% for article in blog.articles %}
        {% if forloop.first %}
          <!-- Featured Article (First one) -->
          <article class="article-featured">
            <a href="{{ article.url }}" class="article-image-link featured-img-wrapper">
              {% if article.image != blank %}
                <img src="{{ article.image | img_url: '1200x' }}" alt="{{ article.image.alt }}" class="article-img">
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'article-placeholder' }}
              {% endif %}
            </a>
            <div class="article-content featured-content">
              <h2 class="article-heading"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              
              {% if section.settings.show_date %}
                <span class="article-date">{{ article.published_at | date: "%B %d, %Y" }}</span>
              {% endif %}
              
              {% if section.settings.show_excerpt %}
                <p class="article-excerpt">
                  {% if article.excerpt.size > 0 %}
                    {{ article.excerpt | strip_html | truncatewords: 30 }}
                  {% else %}
                    {{ article.content | strip_html | truncatewords: 30 }}
                  {% endif %}
                </p>
              {% endif %}
              
              {% if section.settings.read_more_text != blank %}
                <a href="{{ article.url }}" class="article-read-more">{{ section.settings.read_more_text }}</a>
              {% endif %}
            </div>
          </article>
          
          <div class="article-grid"> <!-- Start grid for remaining articles -->
        {% else %}
          <!-- Standard Grid Articles -->
          <article class="article-standard">
            <a href="{{ article.url }}" class="article-image-link standard-img-wrapper">
              {% if article.image != blank %}
                <img src="{{ article.image | img_url: '800x' }}" alt="{{ article.image.alt }}" class="article-img">
              {% else %}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'article-placeholder' }}
              {% endif %}
            </a>
            <div class="article-content">
              <h2 class="article-heading"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              
              {% if section.settings.show_date %}
                <span class="article-date">{{ article.published_at | date: "%B %d, %Y" }}</span>
              {% endif %}
              
              {% if section.settings.show_excerpt %}
                <p class="article-excerpt">
                  {% if article.excerpt.size > 0 %}
                    {{ article.excerpt | strip_html | truncatewords: 20 }}
                  {% else %}
                    {{ article.content | strip_html | truncatewords: 20 }}
                  {% endif %}
                </p>
              {% endif %}
              
              {% if section.settings.read_more_text != blank %}
                <a href="{{ article.url }}" class="article-read-more">{{ section.settings.read_more_text }}</a>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% else %}
        <!-- Dummy Content for Preview in Editor if no blog assigned -->
        <article class="article-featured">
          <div class="article-image-link featured-img-wrapper">
            <div class="placeholder-img" style="background-color: #E6E2DA; width: 100%; height: 100%;"></div>
          </div>
          <div class="article-content featured-content">
            <h2 class="article-heading">How to Choose the Perfect Braid Color for Your Skin Tone</h2>
            {% if section.settings.show_date %}<span class="article-date">June 30, 2026</span>{% endif %}
            {% if section.settings.show_excerpt %}<p class="article-excerpt">Choosing the right braid color can elevate your entire look - but with so many beautiful shades out there, where do you start? Here's a quick guide...</p>{% endif %}
            {% if section.settings.read_more_text != blank %}<span class="article-read-more">{{ section.settings.read_more_text }}</span>{% endif %}
          </div>
        </article>
        <div class="article-grid">
          <article class="article-standard">
            <div class="article-image-link standard-img-wrapper">
              <div class="placeholder-img" style="background-color: #E6E2DA; width: 100%; height: 100%;"></div>
            </div>
            <div class="article-content">
              <h2 class="article-heading">5 Ways to Keep Your Scalp Healthy While Wearing Braids</h2>
              {% if section.settings.show_date %}<span class="article-date">June 30, 2026</span>{% endif %}
              {% if section.settings.show_excerpt %}<p class="article-excerpt">Braids are protective — but your scalp still needs love. Here's how to keep it fresh, flake-free, and happy...</p>{% endif %}
              {% if section.settings.read_more_text != blank %}<span class="article-read-more">{{ section.settings.read_more_text }}</span>{% endif %}
            </div>
          </article>
          <article class="article-standard">
            <div class="article-image-link standard-img-wrapper">
              <div class="placeholder-img" style="background-color: #E6E2DA; width: 100%; height: 100%;"></div>
            </div>
            <div class="article-content">
              <h2 class="article-heading">Vacation-Ready Styles: Best Braids for Travel</h2>
              {% if section.settings.show_date %}<span class="article-date">June 30, 2026</span>{% endif %}
              {% if section.settings.show_excerpt %}<p class="article-excerpt">No one wants to be messing with their hair while on vacation. Here are our top picks for styles that travel well and still slay...</p>{% endif %}
              {% if section.settings.read_more_text != blank %}<span class="article-read-more">{{ section.settings.read_more_text }}</span>{% endif %}
            </div>
          </article>
      {% endfor %}
      
      </div> <!-- End grid -->
    </div>

  </div>
</section>

<style>
  .braid-main-blog {
    padding: 8rem 4rem 6rem;
  }
  .blog-container {
    max-width: 1400px;
    margin: 0 auto;
  }
  .blog-title {
    font-size: 3.5rem;
    font-family: var(--font-heading-family) !important;
    margin: 0 0 3rem 0;
    font-weight: 400;
    color: var(--color-base-text);
  }
  
  .article-featured {
    display: flex;
    gap: 4rem;
    margin-bottom: 4rem;
    align-items: center;
  }
  .featured-img-wrapper {
    flex: 2;
    aspect-ratio: 16/9;
    overflow: hidden;
  }
  .featured-content {
    flex: 1;
    padding-right: 2rem;
  }
  
  .article-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem;
  }
  .standard-img-wrapper {
    display: block;
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  
  .article-img, .article-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .article-image-link:hover .article-img {
    transform: scale(1.03);
  }
  
  .article-heading {
    font-size: 1.6rem;
    font-family: var(--font-heading-family) !important;
    margin: 0 0 0.8rem 0;
    font-weight: 400;
    line-height: 1.2;
  }
  .featured-content .article-heading {
    font-size: 2.2rem;
  }
  .article-heading a {
    text-decoration: none;
    color: var(--color-base-text);
  }
  .article-date {
    font-size: 0.95rem;
    font-family: var(--font-body-family);
    opacity: 0.7;
    display: block;
    margin-bottom: 1.2rem;
  }
  .article-excerpt {
    font-size: 1.05rem;
    font-family: var(--font-body-family);
    line-height: 1.6;
    color: var(--color-base-text);
    opacity: 0.85;
    margin-bottom: 1.5rem;
  }
  .article-read-more {
    font-size: 1rem;
    color: var(--color-base-text);
    text-decoration: none;
    opacity: 0.8;
  }
  .article-read-more:hover {
    opacity: 1;
  }
  
  @media screen and (max-width: 900px) {
    .article-featured { flex-direction: column; gap: 2rem; }
    .article-grid { grid-template-columns: 1fr; }
    .blog-title { font-size: 3rem; }
  }
</style>

{% schema %}
{
  "name": "Braid Blog Layout",
  "settings": [
    {
      "type": "text",
      "id": "title_override",
      "label": "Heading Override",
      "info": "Leave blank to use default blog name (e.g. 'News')"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show article date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show article excerpt",
      "default": true
    },
    {
      "type": "text",
      "id": "read_more_text",
      "label": "Read more text",
      "default": "Read more..."
    }
  ]
}
{% endschema %}
