<section class="clone-split-hero" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="clone-hero-image">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1500 | image_tag: loading: 'eager', class: 'hero-img' }}
    {% else %}
      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>
  
  <div class="clone-hero-content">
    <div class="hero-content-inner">
      <h1 class="hero-title" style="font-size: {{ section.settings.heading_size }}px;">{{ section.settings.heading }}</h1>
      <p class="hero-text">{{ section.settings.subheading }}</p>
      
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="hero-btn" style="background-color: {{ section.settings.text_color }}; color: {{ section.settings.bg_color }};">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .clone-split-hero {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 100vh;
  }
  
  .clone-hero-image {
    width: 100%;
    height: 50vh;
    overflow: hidden;
  }
  
  .hero-img, .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .placeholder-svg {
    background-color: #f3f3f3;
  }
  
  .clone-hero-content {
    width: 100%;
    height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  
  .hero-content-inner {
    max-width: 500px;
    text-align: left;
  }
  
  .hero-title {
    margin-top: 0;
    margin-bottom: 1.5rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  
  .hero-text {
    font-size: 1.1rem;
    line-height: 1.5;
    margin-bottom: 2rem;
    opacity: 0.9;
  }
  
  .hero-btn {
    display: inline-block;
    padding: 1rem 2rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.9rem;
    transition: opacity 0.3s ease;
  }
  
  .hero-btn:hover {
    opacity: 0.8;
  }
  
  /* Desktop Layout */
  @media screen and (min-width: 768px) {
    .clone-split-hero {
      flex-direction: row;
      height: 100vh;
    }
    
    .clone-hero-image, .clone-hero-content {
      width: 50%;
      height: 100%;
    }
    
    .hero-content-inner {
      padding: 4rem;
    }
  }
</style>

{% schema %}
{
  "name": "Braid Split Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Premium Editorial Design"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Heading Size (Desktop)",
      "default": 64
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Introduce your brand with a stunning, high-contrast split screen layout."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Braid Split Hero",
      "category": "Image"
    }
  ]
}
{% endschema %}
