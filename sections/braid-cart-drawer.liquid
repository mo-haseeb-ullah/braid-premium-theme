<div id="cart-drawer-overlay" class="cart-overlay" onclick="closeCartDrawer()"></div>
<div id="braid-cart-drawer" class="cart-drawer-container" style="background-color: var(--color-base-background-1, #FAEDDE);">
  <button class="cart-close-btn" onclick="closeCartDrawer()">
    <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.5" fill="none"><path d="M6 18L18 6M6 6l12 12"></path></svg>
  </button>
  
  <div class="cart-drawer-inner" id="cart-drawer-inner">
    {% if cart.item_count > 0 %}
      <!-- Filled Cart State -->
      <div class="cart-drawer-header">
        <h2 class="cart-filled-title">Your cart</h2>
      </div>
      
      <div class="cart-drawer-items">
        <div class="cart-items-labels">
          <span class="label-product">PRODUCT</span>
          <span class="label-qty">QUANTITY</span>
          <span class="label-total">TOTAL</span>
        </div>
        
        {% for item in cart.items %}
          <div class="cart-item">
            <div class="cart-item-image">
              <img src="{{ item.image | img_url: '200x' }}" alt="{{ item.title | escape }}">
            </div>
            
            <div class="cart-item-info">
              <h4 class="cart-item-title">{{ item.product.title }}</h4>
              {% unless item.product.has_only_default_variant %}
                <p class="cart-item-variant">{{ item.variant.title }}</p>
              {% endunless %}
              <p class="cart-item-price">{{ item.price | money }}</p>
            </div>
            
            <div class="cart-item-qty">
              <div class="qty-selector">
                <button type="button" onclick="changeCartQty('{{ item.key }}', {{ item.quantity | minus: 1 }})">&minus;</button>
                <input type="text" value="{{ item.quantity }}" readonly>
                <button type="button" onclick="changeCartQty('{{ item.key }}', {{ item.quantity | plus: 1 }})">&plus;</button>
              </div>
              <button type="button" class="cart-remove-btn" onclick="changeCartQty('{{ item.key }}', 0)">
                <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="1.5" fill="none"><path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"></path></svg>
              </button>
            </div>
            
            <div class="cart-item-total">
              {{ item.final_line_price | money }}
            </div>
          </div>
        {% endfor %}
      </div>
      
      <div class="cart-drawer-footer">
        <div class="cart-subtotal">
          <span class="subtotal-label">Estimated total</span>
          <span class="subtotal-price">{{ cart.total_price | money_with_currency }}</span>
        </div>
        <p class="cart-tax-note">Taxes, discounts and shipping calculated at checkout.</p>
        <form action="/cart" method="post" id="cart">
          <button type="submit" name="checkout" class="btn-checkout">CHECK OUT</button>
        </form>
      </div>

    {% else %}
      <!-- Empty Cart State -->
      <div class="cart-drawer-content">
        <h2 class="cart-empty-title">{{ section.settings.empty_title }}</h2>
        <p class="cart-login-prompt">
          {{ section.settings.login_prompt_text }} <a href="/account/login">{{ section.settings.login_prompt_link_text }}</a>
        </p>
        <a href="{{ section.settings.continue_link }}" class="btn-continue-shopping">{{ section.settings.continue_text }}</a>
      </div>
    {% endif %}
  </div>
</div>

<style>
  .cart-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0,0,0,0.4);
    z-index: 99999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .cart-overlay.active {
    opacity: 1;
    visibility: visible;
  }
  .cart-drawer-container {
    position: fixed;
    top: 0;
    right: -600px;
    width: 100%;
    max-width: 550px;
    height: 100vh;
    z-index: 100000;
    box-shadow: -5px 0 15px rgba(0,0,0,0.05);
    transition: right 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    display: flex;
    flex-direction: column;
  }
  .cart-drawer-container.active {
    right: 0;
  }
  .cart-drawer-inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .cart-close-btn {
    position: absolute;
    top: 2rem;
    right: 2rem;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-base-text);
    z-index: 10;
  }
  
  /* Empty State */
  .cart-drawer-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 3rem;
    text-align: center;
  }
  .cart-empty-title {
    font-family: var(--font-heading-family);
    font-size: 3.2rem;
    font-weight: 400;
    color: var(--color-base-text);
    margin-bottom: 1rem;
  }
  .cart-login-prompt {
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    color: var(--color-base-text);
    margin-bottom: 2.5rem;
  }
  .cart-login-prompt a {
    color: var(--color-base-text);
    text-decoration: underline;
  }
  .btn-continue-shopping {
    display: inline-block;
    background-color: #6C4F3D;
    color: #fff;
    font-family: var(--font-body-family);
    font-weight: 600;
    font-size: 1.1rem;
    padding: 1.2rem 3rem;
    border-radius: 12px;
    text-decoration: none;
    transition: background-color 0.3s;
  }
  .btn-continue-shopping:hover {
    background-color: #553E30;
  }

  /* Filled State */
  .cart-drawer-header {
    padding: 3rem 2rem 1.5rem 2rem;
  }
  .cart-filled-title {
    font-family: var(--font-heading-family);
    font-size: 2.5rem;
    font-weight: 400;
    margin: 0;
    color: var(--color-base-text);
  }
  
  .cart-drawer-items {
    flex: 1;
    overflow-y: auto;
    padding: 0 2rem;
  }
  .cart-items-labels {
    display: grid;
    grid-template-columns: 3fr 2fr 1fr;
    border-bottom: 1px solid rgba(0,0,0,0.05);
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .cart-items-labels span {
    font-family: var(--font-body-family);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 1px;
    color: rgba(0,0,0,0.5);
  }
  .label-qty { text-align: right; padding-right: 20px;}
  .label-total { text-align: right; }
  
  .cart-item {
    display: grid;
    grid-template-columns: 80px 1fr auto auto;
    gap: 1rem;
    align-items: center;
    margin-bottom: 2rem;
  }
  .cart-item-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  .cart-item-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .cart-item-title {
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 500;
    margin: 0;
    color: var(--color-base-text);
  }
  .cart-item-variant {
    font-family: var(--font-body-family);
    font-size: 0.85rem;
    color: rgba(0,0,0,0.6);
    margin: 0;
  }
  .cart-item-price {
    font-family: var(--font-body-family);
    font-size: 0.95rem;
    margin: 0;
  }
  
  .cart-item-qty {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-content: flex-end;
  }
  .qty-selector {
    display: flex;
    align-items: center;
    border: 1px solid rgba(0,0,0,0.2);
  }
  .qty-selector button {
    background: transparent;
    border: none;
    width: 30px;
    height: 35px;
    cursor: pointer;
    font-size: 1rem;
  }
  .qty-selector input {
    width: 30px;
    text-align: center;
    border: none;
    background: transparent;
    font-family: var(--font-body-family);
  }
  .cart-remove-btn {
    background: #8b6b5d;
    color: white;
    border: none;
    width: 35px;
    height: 35px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .cart-remove-btn:hover { opacity: 0.8; }
  
  .cart-item-total {
    font-family: var(--font-body-family);
    font-size: 1rem;
    text-align: right;
  }
  
  .cart-drawer-footer {
    padding: 2rem;
    border-top: 1px solid rgba(0,0,0,0.05);
    background: var(--color-base-background-1, #FAEDDE);
  }
  .cart-subtotal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .subtotal-label {
    font-family: var(--font-heading-family);
    font-size: 1.2rem;
  }
  .subtotal-price {
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    font-weight: 600;
  }
  .cart-tax-note {
    font-family: var(--font-body-family);
    font-size: 0.85rem;
    color: rgba(0,0,0,0.6);
    margin-bottom: 1.5rem;
    text-align: right;
  }
  .btn-checkout {
    display: block;
    width: 100%;
    background-color: #8b6b5d;
    color: #fff;
    font-family: var(--font-body-family);
    font-weight: 600;
    font-size: 1.1rem;
    padding: 1.2rem;
    border-radius: 4px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    text-align: center;
    letter-spacing: 1px;
    transition: background-color 0.3s;
  }
  .btn-checkout:hover {
    background-color: #6C4F3D;
  }

  @media screen and (max-width: 500px) {
    .cart-drawer-container { width: 100vw; max-width: 100vw; }
    .cart-item { grid-template-columns: 60px 1fr; gap: 0.5rem; margin-bottom: 1.5rem; }
    .cart-item-qty { grid-column: 2; justify-content: flex-start; margin-top: 0.5rem; }
    .cart-item-total { display: none; }
    .cart-items-labels { display: none; }
  }
</style>

<script>
  function openCartDrawer(e) {
    if(e) e.preventDefault();
    document.getElementById('braid-cart-drawer').classList.add('active');
    document.getElementById('cart-drawer-overlay').classList.add('active');
    document.body.style.overflow = 'hidden';
  }
  
  function closeCartDrawer() {
    document.getElementById('braid-cart-drawer').classList.remove('active');
    document.getElementById('cart-drawer-overlay').classList.remove('active');
    document.body.style.overflow = '';
  }

  // Update Cart UI via Section Rendering API
  function updateCartUI() {
    fetch(window.location.pathname + '?sections=braid-cart-drawer,braid-header&t=' + Date.now())
      .then(res => res.json())
      .then(data => {
        if (data['braid-cart-drawer']) {
          const drawerHtml = new DOMParser().parseFromString(data['braid-cart-drawer'], 'text/html');
          const newInner = drawerHtml.getElementById('cart-drawer-inner');
          if (newInner) {
            document.getElementById('cart-drawer-inner').innerHTML = newInner.innerHTML;
          }
        }
        if (data['braid-header']) {
          const headerHtml = new DOMParser().parseFromString(data['braid-header'], 'text/html');
          const newBubble = headerHtml.getElementById('cart-count-bubble');
          const oldBubble = document.getElementById('cart-count-bubble');
          if (newBubble && oldBubble) {
            oldBubble.innerHTML = newBubble.innerHTML;
            oldBubble.style.display = newBubble.style.display;
          }
        }
        openCartDrawer();
      });
  }

  // Handle Qty Changes inside Drawer
  function changeCartQty(key, qty) {
    document.getElementById('cart-drawer-inner').style.opacity = '0.5';
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: qty })
    })
    .then(() => {
      document.getElementById('cart-drawer-inner').style.opacity = '1';
      updateCartUI();
    })
    .catch(err => {
      console.error(err);
      document.getElementById('cart-drawer-inner').style.opacity = '1';
    });
  }

  // Intercept Add to Cart Forms anywhere on the site
  document.addEventListener('submit', function(e) {
    if (e.target.action && e.target.action.includes('/cart/add')) {
      e.preventDefault();
      const submitBtn = e.target.querySelector('button[type="submit"], input[type="submit"]');
      const originalText = submitBtn ? (submitBtn.innerHTML || submitBtn.value) : '';
      if(submitBtn) {
        if(submitBtn.tagName === 'INPUT') submitBtn.value = 'Adding...';
        else submitBtn.innerHTML = 'Adding...';
      }
      
      fetch('/cart/add.js', {
        method: 'POST',
        body: new FormData(e.target)
      })
      .then(res => res.json())
      .then(() => {
        if(submitBtn) {
          if(submitBtn.tagName === 'INPUT') submitBtn.value = originalText;
          else submitBtn.innerHTML = originalText;
        }
        updateCartUI();
      })
      .catch(err => console.error(err));
    }
  });
</script>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": [
    {
      "type": "text",
      "id": "empty_title",
      "label": "Empty Cart Title",
      "default": "Your cart is empty"
    },
    {
      "type": "text",
      "id": "login_prompt_text",
      "label": "Login Prompt Text",
      "default": "Have an account?"
    },
    {
      "type": "text",
      "id": "login_prompt_link_text",
      "label": "Login Link Text",
      "default": "Log in to check out faster."
    },
    {
      "type": "text",
      "id": "continue_text",
      "label": "Continue Shopping Button Text",
      "default": "Continue shopping"
    },
    {
      "type": "url",
      "id": "continue_link",
      "label": "Continue Shopping Link",
      "default": "/collections/all"
    }
  ]
}
{% endschema %}
